<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <shape>
            <solid android:color="@color/default_tr"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/sys_black"/>
            <stroke
                android:width="@dimen/space_0"
                android:color="@color/sys_blue"/>
            <corners android:radius="@dimen/space_0_5x"/>
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:drawable/alert_light_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/view_log_catch_title"
        android:background="@color/design_default_color_error"
        android:paddingTop="@dimen/space_0_5x"
        android:paddingBottom="@dimen/space_0_5x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_0_5x"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="@android:color/secondary_text_light"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_5x"
            android:text="关闭"
            android:layout_weight="1"/>
        <Button
            android:textColor="@android:color/holo_blue_light"
            android:id="@+id/export"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_5x"
            android:text="发给客服"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>

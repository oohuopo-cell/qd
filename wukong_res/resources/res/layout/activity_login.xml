<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/activity_login_iv_close"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/margin2x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ico_back_gray_90"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/activity_login_iv_setting"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/margin2x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/select_tabbar_my_4"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/activity_login_llTips_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin3x"
        android:layout_below="@+id/activity_login_iv_close">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/activity_login_iv_logo"
            android:layout_width="@dimen/layout_height_xxl"
            android:layout_height="@dimen/layout_height_xxl"
            android:src="@drawable/wk_icon"/>
        <TextView
            android:textSize="@dimen/text_display_l"
            android:textColor="@color/sys_black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/activity_login_tv_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_6x"
            android:layout_margin="@dimen/margin2x"
            android:text="@string/xm_name"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:layout_gravity="center"
        android:id="@+id/tvItemTitle"
        android:layout_width="@dimen/space_0"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:layout_marginStart="@dimen/margin2x"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:layout_gravity="center"
        android:id="@+id/tvItemValue"
        android:paddingTop="@dimen/margin1x"
        android:paddingBottom="@dimen/margin1x"
        android:layout_width="@dimen/space_0"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:layout_marginEnd="@dimen/margin1x"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:layout_gravity="center"
        android:id="@+id/tvItemAction"
        android:paddingTop="@dimen/margin1x"
        android:paddingBottom="@dimen/margin1x"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin2x"/>
</LinearLayout>

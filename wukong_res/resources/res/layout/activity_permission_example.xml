<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <info.red.virtual.standardui.webview.SimpleWebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:id="@+id/ll_bottom1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin2x"
        android:paddingEnd="@dimen/margin2x">
        <include
            android:id="@+id/bt_batch_shortcut"
            layout="@layout/layout_bt_batch_shortcut"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:gravity="center"
            android:id="@+id/activity_permission_tvGo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/to_settings"
            android:layout_marginVertical="@dimen/margin1x"
            style="@style/RadiusButton.large"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bottom2"
        android:background="@drawable/bg_outline_979797"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin2x"
        android:paddingEnd="@dimen/margin2x">
        <TextView
            android:textSize="@dimen/text_body_m"
            android:gravity="center"
            android:id="@+id/go"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/to_settings"
            android:layout_marginVertical="@dimen/margin1x"
            style="@style/RadiusButton.large"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:gravity="center"
            android:id="@+id/batch_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="批量放桌面"
            style="@style/RadiusButton.large"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@+id/wk_search_back"
        android:background="@drawable/gray_select"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@mipmap/ico_back_144"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/wk_search_field"
        android:background="@drawable/bg_white_radius20"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_5x"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_blue"
            android:gravity="center"
            android:id="@+id/wk_search_region"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search_region_china"
            android:paddingStart="@dimen/space_1x"
            android:paddingEnd="@dimen/space_0_5x"/>
        <ImageView
            android:id="@+id/wk_search_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ico_search_60"
            android:importantForAccessibility="no"
            android:paddingStart="@dimen/space_1x"
            android:paddingEnd="@dimen/space_0_5x"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <EditText
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_black"
                android:textColorHint="@color/sys_gray1"
                android:id="@+id/wk_search_input"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:paddingStart="@dimen/space_0"
                android:paddingEnd="@dimen/layout_height_xs"
                android:importantForAutofill="no"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/wk_search_clear"
                android:padding="@dimen/space_0_5x"
                android:visibility="invisible"
                android:layout_width="@dimen/layout_height_xs"
                android:layout_height="@dimen/layout_height_xs"
                android:src="@mipmap/ico_close_72"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:gravity="center"
        android:id="@+id/wk_search_action"
        android:background="@drawable/gray_select"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/txt_search"
        android:paddingStart="@dimen/space_1x"
        android:paddingEnd="@dimen/icon_s_20"/>
</merge>

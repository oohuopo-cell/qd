<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_title_l"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:id="@+id/tv_avatar_crop_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/setting_profile_avatar_crop_title"
        android:layout_marginStart="@dimen/margin2x"
        android:layout_marginEnd="@dimen/margin2x"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_gray1"
        android:gravity="center"
        android:id="@+id/tv_avatar_crop_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/setting_profile_avatar_crop_hint"
        android:layout_marginStart="@dimen/margin2x"
        android:layout_marginEnd="@dimen/margin2x"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <info.red.virtual.standardui.widget.CorpToView
            android:id="@+id/avatar_crop_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/strokeWidth"
            android:layout_alignLeft="@+id/avatar_crop_grid"
            android:layout_alignTop="@+id/avatar_crop_grid"
            android:layout_alignRight="@+id/avatar_crop_grid"
            android:layout_alignBottom="@+id/avatar_crop_grid"
            android:layout_centerInParent="true"/>
        <info.red.virtual.standardui.widget.AspectRatioImageView
            android:id="@+id/avatar_crop_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin3x"
            android:layout_marginRight="@dimen/margin3x"
            android:src="@mipmap/ico_frame_924"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="@dimen/margin3x"
            app:AspectRatioImageView_X="1"
            app:AspectRatioImageView_Y="1"/>
    </RelativeLayout>
    <RelativeLayout
        android:paddingTop="@dimen/margin1x"
        android:paddingBottom="@dimen/margin1x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/text_body_m"
            android:id="@+id/btn_avatar_crop_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/btn_cancel"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_alignParentStart="true"
            style="@style/CancelRadiusButton"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/text_body_m"
            android:id="@+id/btn_avatar_crop_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/done"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"
            style="@style/RadiusButton"/>
    </RelativeLayout>
</LinearLayout>

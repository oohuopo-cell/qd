<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/margin2x"
    android:layout_marginRight="@dimen/margin2x"
    android:layout_marginHorizontal="@dimen/margin2x">
    <FrameLayout
        android:id="@+id/video_container"
        android:background="@color/sys_black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toTopOf="@+id/progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <VideoView
            android:layout_gravity="center"
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_play"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_video_play"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_gray1"
            android:layout_gravity="center"
            android:id="@+id/iv_fail"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watermark_play_fail"
            android:drawableTop="@drawable/icon_video_playfail"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/media_controller_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_container"/>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:layout_marginLeft="@dimen/margin2x"
        android:layout_marginTop="@dimen/margin2x"
        android:layout_marginRight="@dimen/margin2x"
        android:layout_marginBottom="@dimen/margin1x"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/bg_app_menu_download_progress2"
        android:layout_marginHorizontal="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_white"
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/watermark_save_to_gallery"
        app:layout_constraintBottom_toBottomOf="@+id/progress"
        app:layout_constraintEnd_toEndOf="@+id/progress"
        app:layout_constraintStart_toStartOf="@+id/progress"
        app:layout_constraintTop_toTopOf="@+id/progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/activity_backup_rvBackup_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/activity_backup_btvClick_list"
            android:layout_alignParentTop="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:gravity="center"
            android:id="@+id/activity_backup_btvClick_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginBottom="@dimen/margin1x"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_marginEnd="@dimen/margin2x"
            style="@style/RadiusButton.large"/>
        <RelativeLayout
            android:id="@+id/activity_backup_rlLoading_list"
            android:background="@color/sys_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/activity_backup_dialog_loading_progressbar"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                style="@style/TProgressStyle"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>

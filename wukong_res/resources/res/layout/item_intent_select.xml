<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_icon"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/icon_l_48"
        android:layout_height="@dimen/icon_l_48"
        android:src="@drawable/ico_app_icon_default_90"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/SpRoundedStyleCorner12"/>
    <LinearLayout
        android:orientation="vertical"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_name"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="应用名称"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_tag"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="备注"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/sys_red"
        android:id="@+id/tv_init_hint"
        android:padding="8dp"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="未初始化"/>
</LinearLayout>

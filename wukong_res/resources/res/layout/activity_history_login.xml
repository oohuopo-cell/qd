<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <TextView
        android:textSize="@dimen/text_title_l"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:id="@+id/tip_alter"
        android:background="@color/sys_gray6"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:text=""
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/tip_alter"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bt_agree_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv">
        <TextView
            android:enabled="true"
            android:id="@+id/check_agree_policy"
            android:background="@drawable/select_vip_privacy_checkbox"
            android:layout_width="@dimen/icon_s_20"
            android:layout_height="@dimen/icon_s_20"
            android:checked="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_login_bottom_agree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0"
            android:layout_marginStart="@dimen/space_3x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/tv_login_policy"/>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_white"
            android:id="@+id/tv_tip_bubble"
            android:background="@drawable/bg_tip_bubble"
            android:paddingLeft="@dimen/margin1x"
            android:paddingRight="@dimen/margin1x"
            android:paddingBottom="@dimen/space_1x"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0"
            android:text="@string/login_phone_sms_tip_bubble"
            android:backgroundTint="@color/sys_black"
            android:paddingHorizontal="@dimen/margin1x"
            app:layout_constraintStart_toStartOf="@+id/check_agree_policy"
            app:layout_constraintTop_toBottomOf="@+id/check_agree_policy"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tv_login_other"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/icon_s_20"
        android:text="@string/login_other_account"
        android:layout_marginStart="@dimen/margin2x"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RadiusButton.large"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_last"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bt_agree_policy, tv_login_other"/>
</androidx.constraintlayout.widget.ConstraintLayout>

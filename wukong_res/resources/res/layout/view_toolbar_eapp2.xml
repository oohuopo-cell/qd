<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_toolbar_eapp_bg"
    android:background="@color/sys_gray6"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <info.red.virtual.standardui.widget.BasicToolBar
        android:id="@+id/view_toolbar_eapp_bar"
        android:layout_height="48dp"
        app:menu="@menu/menu_home2"
        app:titleTextColor="@color/sys_black"
        style="@style/BasicToolBarStyleGray"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xm_name"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="center_vertical"
            android:id="@+id/top_vip_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="10dp"
            app:cardBackgroundColor="@color/home_top_vip_1"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/top_vip_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/ico_home_crown_1"
                    android:importantForAccessibility="no"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="5dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/sys_black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/top_vip_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>

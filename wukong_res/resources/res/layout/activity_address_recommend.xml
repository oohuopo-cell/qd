<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x">
        <include
            android:id="@+id/toolbar"
            layout="@layout/yun_layout_tab"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_blue"
                android:gravity="center_vertical"
                android:id="@+id/map_pick"
                android:paddingLeft="@dimen/margin1x"
                android:paddingRight="@dimen/margin1x"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/location_privacy_map_pick"
                android:layout_marginEnd="@dimen/margin1x"
                android:paddingHorizontal="@dimen/margin1x"/>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_blue"
                android:gravity="center_vertical"
                android:id="@+id/cancel"
                android:paddingLeft="@dimen/margin1x"
                android:paddingRight="@dimen/margin1x"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/location_privacy_restore"
                android:paddingHorizontal="@dimen/margin1x"/>
        </LinearLayout>
    </FrameLayout>
    <info.red.virtual.standardui.widget.WkSearchBar
        android:id="@+id/enter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:layout_marginLeft="@dimen/icon_s_20"
        android:layout_marginRight="@dimen/icon_s_20"
        android:layout_marginHorizontal="@dimen/icon_s_20"
        app:wkSearchHint="@string/enter_address_first"
        app:wkSearchMode="entry"/>
    <include
        android:id="@+id/history_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/include_wk_history_header"/>
    <info.red.virtual.standardui.recyclerview.SwipeRecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            android:layout_marginLeft="@dimen/margin2x"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginRight="@dimen/margin2x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/payCloud"
            android:layout_marginHorizontal="@dimen/margin2x"
            android:layout_marginVertical="@dimen/margin1x"
            style="@style/M3IconWithTextNoLimitMargin.Big"/>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_essential_toolbar"/>
    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin2x"
        android:layout_marginRight="@dimen/margin2x"
        android:src="@mipmap/img_private_icon_tip"
        android:maxWidth="328dp"
        android:layout_marginHorizontal="@dimen/margin2x"
        app:layout_constraintBottom_toTopOf="@+id/tv"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:gravity="center_horizontal"
        android:id="@+id/tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_height_xs"
        android:layout_marginBottom="@dimen/space_1x"
        android:text="开启后，请到手机桌面\10找到计算器图标进入悟空分身"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/bottom"
        app:layout_constraintTop_toBottomOf="@+id/img"/>
    <FrameLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_8x"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_start"
            android:layout_marginLeft="@dimen/margin2x"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginRight="@dimen/margin2x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="开始使用"
            android:layout_marginHorizontal="@dimen/margin2x"
            android:layout_marginVertical="@dimen/margin1x"
            style="@style/M3IconWithTextNoLimitMargin.Big"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

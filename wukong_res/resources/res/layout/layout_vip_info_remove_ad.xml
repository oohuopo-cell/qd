<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_1x">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_vip_info_remove_ad_item"
        android:background="@drawable/select_vip_info_remove_ad"
        android:layout_width="@dimen/space_0"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="112:140"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/space_1_5x"
            android:textColor="@color/vip_info_item_remove_bg"
            android:id="@+id/tv_vip_info_remove_ad_item_title_top"
            android:background="@drawable/bg_vip_info_sub_remove_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding1x"
            android:paddingEnd="@dimen/padding1x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/space_1_5x"
            android:textColor="@color/vip_info_item_remove_title"
            android:id="@+id/tv_vip_info_remove_ad_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5x"
            android:layout_marginStart="@dimen/icon_s_20"
            android:layout_marginEnd="@dimen/icon_s_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_info_remove_ad_item_title_top"/>
        <TextView
            android:textSize="@dimen/icon_s_20"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_vip_info_remove_ad_item_price_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥"
            app:layout_constraintBottom_toBottomOf="@+id/tv_vip_info_remove_ad_item_price"
            app:layout_constraintEnd_toStartOf="@+id/tv_vip_info_remove_ad_item_price"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_vip_info_remove_ad_item_price"/>
        <TextView
            android:textSize="@dimen/layout_height_xs"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_vip_info_remove_ad_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/tv_vip_info_remove_ad_item_price_left"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_info_remove_ad_item_title"/>
        <TextView
            android:textSize="@dimen/space_1_5x"
            android:id="@+id/tv_vip_info_remove_ad_item_fake_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_info_remove_ad_item_price"/>
        <TextView
            android:textSize="@dimen/space_1_5x"
            android:textColor="@color/vip_info_item_remove_title"
            android:id="@+id/tv_vip_info_remove_ad_item_price_subtract"
            android:background="@drawable/bg_vip_info_remove_price_subtract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5x"
            android:layout_marginBottom="@dimen/space_1x"
            android:maxLines="1"
            android:paddingStart="@dimen/padding1x"
            android:paddingEnd="@dimen/padding1x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_info_remove_ad_item_fake_price"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

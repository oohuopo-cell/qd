<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/csl_send_code"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/space_1x"
            android:src="@drawable/wk_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_title_l"
            android:textStyle="bold"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:text="@string/xm_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <View
            android:id="@+id/view_bg"
            android:background="@drawable/bg_white_radius24"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_6x"
            android:layout_marginLeft="@dimen/margin2x"
            android:layout_marginTop="@dimen/space_3x"
            android:layout_marginRight="@dimen/margin2x"
            android:backgroundTint="@color/sys_gray6"
            android:layout_marginHorizontal="@dimen/margin2x"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_name"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_qu"
            android:layout_width="@dimen/space_8x"
            android:layout_height="wrap_content"
            android:text="@string/login_phone_sms_86"
            android:layout_marginStart="@dimen/margin2x"
            app:layout_constraintBottom_toBottomOf="@+id/view_bg"
            app:layout_constraintStart_toStartOf="@+id/view_bg"
            app:layout_constraintTop_toTopOf="@+id/view_bg"/>
        <EditText
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:textColorHint="@color/sys_gray1"
            android:layout_gravity="center"
            android:id="@+id/et_phone"
            android:background="@null"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/login_phone_sms_phone_tint"
            android:singleLine="true"
            android:maxLength="11"
            android:layout_weight="1"
            android:inputType="number"
            android:layout_marginStart="@dimen/margin1x"
            android:layout_marginEnd="10dp"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toBottomOf="@+id/view_bg"
            app:layout_constraintEnd_toStartOf="@+id/bt_clear_et"
            app:layout_constraintStart_toEndOf="@+id/tv_qu"
            app:layout_constraintTop_toTopOf="@+id/view_bg"/>
        <ImageView
            android:id="@+id/bt_clear_et"
            android:padding="@dimen/space_1_5x"
            android:visibility="invisible"
            android:layout_width="@dimen/space_6x"
            android:layout_height="@dimen/space_6x"
            android:src="@mipmap/ico_close_72"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/space_0_5x"
            app:layout_constraintBottom_toBottomOf="@+id/view_bg"
            app:layout_constraintEnd_toEndOf="@+id/view_bg"
            app:layout_constraintTop_toTopOf="@+id/view_bg"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:text="@string/login_phone_sms_tip_auto_register"
            android:layout_marginStart="@dimen/margin2x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_bg"/>
        <TextView
            android:enabled="false"
            android:id="@+id/btn_get_verifycode"
            android:layout_marginLeft="@dimen/margin2x"
            android:layout_marginTop="@dimen/margin2x"
            android:layout_marginRight="@dimen/margin2x"
            android:text="@string/login_phone_sms_phone_get_code"
            android:layout_marginHorizontal="@dimen/margin2x"
            app:layout_constraintTop_toBottomOf="@+id/tv_tip"
            style="@style/LoginPrimaryButton"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_blue"
            android:id="@+id/tv_password"
            android:background="@drawable/shape_bg_gray2_stroke_enable"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:text="@string/login_phone_password"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_get_verifycode"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bt_agree_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:layout_marginStart="@dimen/margin2x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_password">
            <TextView
                android:enabled="true"
                android:id="@+id/check_agree_policy"
                android:background="@drawable/select_vip_privacy_checkbox"
                android:layout_width="@dimen/icon_s_20"
                android:layout_height="@dimen/icon_s_20"
                android:checked="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_login_bottom_agree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0"
                android:layout_marginStart="@dimen/space_3x"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/tv_login_policy"/>
            <TextView
                android:textSize="@dimen/text_note_m"
                android:textColor="@color/sys_white"
                android:id="@+id/tv_tip_bubble"
                android:background="@drawable/bg_tip_bubble"
                android:paddingLeft="@dimen/margin1x"
                android:paddingRight="@dimen/margin1x"
                android:paddingBottom="@dimen/space_1x"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0"
                android:text="@string/login_phone_sms_tip_bubble"
                android:backgroundTint="@color/sys_black"
                android:paddingHorizontal="@dimen/margin1x"
                app:layout_constraintStart_toStartOf="@+id/check_agree_policy"
                app:layout_constraintTop_toBottomOf="@+id/check_agree_policy"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/layout_third_party"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/layout_login_third_party"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/activity_login_progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/icon_display_60"
        android:layout_height="@dimen/icon_display_60"/>
</FrameLayout>

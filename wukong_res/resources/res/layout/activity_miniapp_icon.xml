<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:background="@color/sys_gray6"
        android:paddingBottom="@dimen/margin2x"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <info.red.virtual.standardui.widget.AspectRatioImageView
                android:id="@+id/activity_mod_icon_real_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/layout_height_xs"
                android:layout_marginRight="@dimen/layout_height_xs"
                android:scaleType="fitXY"
                android:layout_marginHorizontal="@dimen/layout_height_xs"
                app:AspectRatioImageView_X="1"
                app:AspectRatioImageView_Y="1"/>
            <info.red.virtual.standardui.widget.CorpToView
                android:id="@+id/activity_mod_icon_crop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/strokeWidth"
                android:layout_alignLeft="@+id/activity_mod_icon_grid"
                android:layout_alignTop="@+id/activity_mod_icon_grid"
                android:layout_alignRight="@+id/activity_mod_icon_grid"
                android:layout_alignBottom="@+id/activity_mod_icon_grid"
                android:layout_centerInParent="true"/>
            <info.red.virtual.standardui.widget.AspectRatioImageView
                android:id="@+id/activity_mod_icon_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin3x"
                android:layout_marginRight="@dimen/margin3x"
                android:scaleType="fitXY"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/margin3x"
                app:AspectRatioImageView_X="1"
                app:AspectRatioImageView_Y="1"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_mod_icon_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6x"
            android:paddingStart="@dimen/margin2x"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:layout_marginBottom="@dimen/margin3x">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/text_body_m"
                android:id="@+id/activity_mod_icon_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel"
                android:layout_alignParentLeft="true"
                android:layout_marginStart="@dimen/margin2x"
                style="@style/CancelRadiusButton"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/text_body_m"
                android:id="@+id/activity_mod_icon_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/done"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="@dimen/margin2x"
                style="@style/RadiusButton"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/activity_mod_icon_progress_view"
        android:background="@color/transparent_black_00"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/activity_mod_icon_progress_bar"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:text="正在生成图标..."/>
    </LinearLayout>
</RelativeLayout>

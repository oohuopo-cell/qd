<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_time"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ico_fail"
        android:layout_marginEnd="@dimen/margin1x"
        app:layout_constraintBottom_toBottomOf="@+id/media_container"
        app:layout_constraintEnd_toStartOf="@+id/media_container"
        app:layout_constraintTop_toTopOf="@+id/media_container"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_avatar"
        android:layout_width="@dimen/space_5x"
        android:layout_height="@dimen/space_5x"
        android:layout_marginTop="18dp"
        android:layout_marginStart="@dimen/space_1x"
        android:layout_marginEnd="@dimen/space_2x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
    <FrameLayout
        android:id="@+id/media_container"
        android:layout_width="160dp"
        android:layout_height="210dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="62dp"
        android:layout_marginEnd="@dimen/space_1x"
        app:layout_constraintEnd_toStartOf="@+id/iv_avatar"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_msg"
            android:background="@drawable/message_sender_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/SpRoundedStyle"/>
        <View
            android:background="@color/sys_black_25"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_gravity="center"
            android:id="@+id/cpi_progress"
            android:visibility="gone"
            android:layout_width="@dimen/space_6x"
            android:layout_height="@dimen/space_6x"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            app:indicatorColor="@color/sys_white"
            app:trackColor="@color/transparent_white_25"
            app:trackThickness="@dimen/space_0_5x"
            style="@style/Widget.MaterialComponents.CircularProgressIndicator.Small"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_play"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_video_play"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_white"
            android:layout_gravity="center"
            android:id="@+id/tv_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_white"
            android:ellipsize="end"
            android:layout_gravity="bottom"
            android:id="@+id/tv_video_title"
            android:background="@color/sys_black_50"
            android:paddingTop="@dimen/space_0_5x"
            android:paddingBottom="@dimen/space_0_5x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/space_1x"
            android:paddingEnd="@dimen/space_1x"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_white"
            android:layout_gravity="end|top"
            android:id="@+id/tv_video_action"
            android:background="@color/sys_black_50"
            android:paddingTop="@dimen/space_0_5x"
            android:paddingBottom="@dimen/space_0_5x"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_1x"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/space_1x"
            android:paddingEnd="@dimen/space_1x"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

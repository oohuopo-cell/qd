<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/bt_close"
            android:padding="10dp"
            android:layout_width="@dimen/space_6x"
            android:layout_height="@dimen/space_6x"
            android:src="@drawable/ico_jiguang_close"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_red"
            android:gravity="center"
            android:id="@+id/tv_tip_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_6x"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_6x"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/tv_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin2x"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/keyboard"
        app:layout_constraintEnd_toEndOf="@+id/keyboard"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keyboard"
        android:paddingBottom="@dimen/margin2x"
        android:layout_width="328dp"
        android:layout_height="430dp"
        android:layout_marginLeft="@dimen/margin2x"
        android:layout_marginRight="@dimen/margin2x"
        android:layout_marginHorizontal="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/bt_c"
            android:padding="@dimen/space_1_5x"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:src="@mipmap/ico_c"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toStartOf="@+id/bt_delete"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/sys_black"
            style="@style/Calculator1"/>
        <ImageView
            android:id="@+id/bt_delete"
            android:padding="@dimen/space_1_5x"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:src="@mipmap/ico_delete"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toStartOf="@+id/bt_percent"
            app:layout_constraintStart_toEndOf="@+id/bt_c"
            app:layout_constraintTop_toTopOf="@+id/bt_c"
            app:tint="@color/sys_black"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_percent"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="%"
            app:layout_constraintEnd_toStartOf="@+id/bt_div"
            app:layout_constraintStart_toEndOf="@+id/bt_delete"
            app:layout_constraintTop_toTopOf="@+id/bt_c"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_div"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="÷"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_percent"
            app:layout_constraintTop_toTopOf="@+id/bt_c"
            style="@style/Calculator2"/>
        <TextView
            android:id="@+id/bt_7"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="7"
            app:layout_constraintBottom_toTopOf="@+id/bt_4"
            app:layout_constraintEnd_toStartOf="@+id/bt_8"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_c"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_8"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="8"
            app:layout_constraintEnd_toStartOf="@+id/bt_9"
            app:layout_constraintStart_toEndOf="@+id/bt_7"
            app:layout_constraintTop_toTopOf="@+id/bt_7"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_9"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="9"
            app:layout_constraintEnd_toStartOf="@+id/bt_mul"
            app:layout_constraintStart_toEndOf="@+id/bt_8"
            app:layout_constraintTop_toTopOf="@+id/bt_7"
            style="@style/Calculator1"/>
        <ImageView
            android:id="@+id/bt_mul"
            android:padding="@dimen/space_1_5x"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:src="@mipmap/ico_mul"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_9"
            app:layout_constraintTop_toTopOf="@+id/bt_7"
            app:tint="@color/sys_white"
            style="@style/Calculator2"/>
        <TextView
            android:id="@+id/bt_4"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="4"
            app:layout_constraintBottom_toTopOf="@+id/bt_1"
            app:layout_constraintEnd_toStartOf="@+id/bt_5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_7"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_5"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="5"
            app:layout_constraintEnd_toStartOf="@+id/bt_6"
            app:layout_constraintStart_toEndOf="@+id/bt_4"
            app:layout_constraintTop_toTopOf="@+id/bt_4"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_6"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="6"
            app:layout_constraintEnd_toStartOf="@+id/bt_minus"
            app:layout_constraintStart_toEndOf="@+id/bt_5"
            app:layout_constraintTop_toTopOf="@+id/bt_4"
            style="@style/Calculator1"/>
        <ImageView
            android:id="@+id/bt_minus"
            android:padding="@dimen/space_1_5x"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:src="@mipmap/ico_minus"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_6"
            app:layout_constraintTop_toTopOf="@+id/bt_4"
            app:tint="@color/sys_white"
            style="@style/Calculator2"/>
        <TextView
            android:id="@+id/bt_1"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="1"
            app:layout_constraintBottom_toTopOf="@+id/bt_0"
            app:layout_constraintEnd_toStartOf="@+id/bt_2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_4"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_2"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="2"
            app:layout_constraintEnd_toStartOf="@+id/bt_3"
            app:layout_constraintStart_toEndOf="@+id/bt_1"
            app:layout_constraintTop_toTopOf="@+id/bt_1"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_3"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="3"
            app:layout_constraintEnd_toStartOf="@+id/bt_add"
            app:layout_constraintStart_toEndOf="@+id/bt_2"
            app:layout_constraintTop_toTopOf="@+id/bt_add"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_add"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="+"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_3"
            app:layout_constraintTop_toTopOf="@+id/bt_1"
            style="@style/Calculator2"/>
        <TextView
            android:id="@+id/bt_0"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_8x"
            android:text="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/bt_2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@+id/bt_1"
            app:layout_constraintTop_toBottomOf="@+id/bt_1"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_dot"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="."
            app:layout_constraintEnd_toEndOf="@+id/bt_3"
            app:layout_constraintStart_toStartOf="@+id/bt_3"
            app:layout_constraintTop_toTopOf="@+id/bt_0"
            style="@style/Calculator1"/>
        <TextView
            android:id="@+id/bt_eq"
            android:layout_width="@dimen/space_8x"
            android:layout_height="@dimen/space_8x"
            android:text="="
            app:layout_constraintEnd_toEndOf="@+id/bt_add"
            app:layout_constraintStart_toStartOf="@+id/bt_add"
            app:layout_constraintTop_toTopOf="@+id/bt_0"
            style="@style/Calculator2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

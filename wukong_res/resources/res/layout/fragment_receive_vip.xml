<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <info.red.virtual.widget.StrokeTextView
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="@color/vip_receive_title"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_pay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_height_xs"
        android:src="@drawable/icon_pay_vip"
        app:layout_constraintEnd_toStartOf="@+id/iv_free"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_free"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_free_vip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_pay"
        app:layout_constraintTop_toTopOf="@+id/iv_pay"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/sys_white"
        android:id="@+id/tv_wechat"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:drawablePadding="@dimen/space_0_5x"
        android:drawableStart="@drawable/icon_wechat_little"
        app:layout_constraintBottom_toBottomOf="@+id/iv_free"
        app:layout_constraintEnd_toEndOf="@+id/iv_free"
        app:layout_constraintStart_toStartOf="@+id/iv_free"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_finger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_finger"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_wechat"
        app:layout_constraintTop_toBottomOf="@+id/tv_wechat"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:gravity="center"
        android:id="@+id/tv_course"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:layout_marginTop="@dimen/space_0_5x"
        android:text="查看教程"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_finger"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_gray1"
        android:gravity="center"
        android:id="@+id/tv_close"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:layout_marginTop="@dimen/space_1x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_course"/>
</androidx.constraintlayout.widget.ConstraintLayout>

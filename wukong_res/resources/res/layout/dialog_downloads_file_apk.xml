<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/dlg_doload_llDlg"
        android:background="@drawable/shape_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DialogContentPadding1x">
        <ImageView
            android:id="@+id/dlg_doload_ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ico_dlg_close_144"
            android:layout_marginEnd="@dimen/margin1x"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/text_title_m"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dlg_doload_tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_miniapp_need_update"
            android:lines="1"
            android:layout_below="@+id/dlg_doload_ivClose"
            android:layout_alignTop="@+id/dlg_doload_ivClose"
            android:layout_alignBottom="@+id/dlg_doload_ivClose"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_marginEnd="@dimen/margin2x"/>
        <ImageView
            android:id="@+id/dlg_load_apk_ivLogo"
            android:visibility="gone"
            android:layout_width="@dimen/icon_display_60"
            android:layout_height="@dimen/icon_display_60"
            android:scaleType="fitXY"
            android:layout_below="@+id/dlg_doload_tvTitle"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/dialog_download_apk_ad"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:layout_marginBottom="@dimen/margin2x"
            android:layout_below="@+id/dlg_load_apk_ivLogo"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_marginVertical="@dimen/margin2x"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:id="@+id/dlg_doload_tips_content"
            android:padding="@dimen/margin1x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tip_miniapp_need_update"
            android:layout_below="@+id/dialog_download_apk_ad"
            android:lineSpacingExtra="@dimen/strokeWidth"
            android:layout_marginEnd="@dimen/margin1x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black_50"
            android:id="@+id/dlg_doload_tv_status"
            android:paddingTop="@dimen/padding1x"
            android:paddingBottom="@dimen/padding1x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dlg_doload_tips_content"/>
        <RelativeLayout
            android:id="@+id/rl_pro_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dlg_doload_tv_status">
            <ProgressBar
                android:id="@+id/dlg_doload_progressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_6x"
                android:layout_margin="@dimen/margin1x"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progressbar_sysblue"
                android:layout_alignParentBottom="@dimen/padding1x"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dlg_doload_btn_ok"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:text="@string/default_btn_text"
                android:contentDescription="@string/tip_begin_download"
                app:backgroundTint="@color/wk_btn"
                style="@style/RadiusButton.large"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:autoLink="web"
            android:id="@+id/dlgDownloadApk_tvOpenTips"
            android:text="@string/download_bt_browser"
            android:layout_below="@+id/rl_pro_btn"
            android:layout_centerHorizontal="true"
            style="@style/TvStyleTitleBlue"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin2x"
            android:layout_below="@+id/dlgDownloadApk_tvOpenTips"/>
    </RelativeLayout>
</LinearLayout>

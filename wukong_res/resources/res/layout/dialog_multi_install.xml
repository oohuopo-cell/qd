<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/shape_bg_white"
    android:padding="@dimen/margin1x"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/close"
            android:layout_width="@dimen/space_6x"
            android:layout_height="@dimen/space_6x"
            android:src="@mipmap/ico_dlg_close_144"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/text_title_l"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分身数量"
            android:layout_alignTop="@+id/close"
            android:layout_alignBottom="@+id/close"
            android:layout_centerHorizontal="true"
            style="@style/RlStyleTitle"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin3x">
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/minus"
            android:background="@drawable/drawable_button_minus"
            android:layout_width="@dimen/layout_height_xs"
            android:layout_height="@dimen/layout_height_xs"
            android:layout_marginEnd="@dimen/margin1x"/>
        <EditText
            android:textSize="@dimen/text_title_m"
            android:gravity="center"
            android:id="@+id/indicator"
            android:layout_width="@dimen/layout_height_xxl"
            android:layout_height="wrap_content"
            android:text="1"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:maxLength="3"
            android:digits="0123456789"
            android:inputType="number"
            style="@style/TvStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/plus"
            android:background="@drawable/drawable_button_plus"
            android:layout_width="@dimen/layout_height_xs"
            android:layout_height="@dimen/layout_height_xs"
            android:layout_marginStart="@dimen/margin1x"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ok"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_6x"
        android:text="@string/confirm"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="@dimen/margin1x"
        app:backgroundTint="@color/sys_blue"
        style="@style/RadiusButton.large.dialog"/>
</LinearLayout>

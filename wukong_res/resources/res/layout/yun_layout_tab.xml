<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_6x"
    app:layout_constraintTop_toTopOf="parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_tab"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBaseline_toBaselineOf="@+id/ivBack_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tabGravity="center"
        app:tabIndicatorColor="@color/sys_black"
        app:tabIndicatorFullWidth="false"
        app:tabRippleColor="@color/sys_black"
        app:tabSelectedTextColor="@color/sys_black"
        app:tabTextAppearance="@style/TabTitleStyle"
        app:tabTextColor="@color/sys_black"/>
    <ImageView
        android:id="@+id/ivBack_tab"
        android:background="@drawable/gray_select"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@mipmap/ico_back_144"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_title_m"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:id="@+id/tvTitle_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/space_6x"
        android:layout_marginEnd="@dimen/space_6x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_duo_right_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin3x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

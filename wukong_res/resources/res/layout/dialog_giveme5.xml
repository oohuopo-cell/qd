<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_white_radius20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/DialogContentPadding1x">
    <ImageView
        android:layout_width="@dimen/layout_height_xxl"
        android:layout_height="@dimen/layout_height_xxl"
        android:layout_marginTop="@dimen/margin1x"
        android:src="@mipmap/img_rating_cry_360"/>
    <TextView
        android:textSize="@dimen/text_title_l"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:padding="@dimen/padding1x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/tip_rate"/>
    <RatingBar
        android:id="@+id/dialog_ratings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:progressTint="@color/sys_yellow"
        android:progressBackgroundTint="@color/sys_gray3"
        android:secondaryProgressTint="@color/sys_yellow"/>
    <TextView
        android:textColor="@color/sys_gray1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:layout_marginBottom="@dimen/margin2x"
        android:text="@string/rating_bottom_title"/>
</LinearLayout>

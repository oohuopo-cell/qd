<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_emu_app_container"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_toolbar_eapp2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <RelativeLayout
        android:id="@+id/fragment_emu_app_rl_emu_Loading"
        android:background="@color/sys_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/fragment_emu_app_progressbar"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:indicatorColor="@color/sys_blue"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/bt_bottom_right"
        android:visibility="gone"
        android:layout_width="@dimen/avatar_xxl_80"
        android:layout_height="@dimen/avatar_xxl_80"
        android:layout_margin="@dimen/space_0_5x"
        android:src="@drawable/img_vip_home_right_bottom"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/vip_coupon_use"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/sys_gray6"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/sys_red_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:id="@+id/tv_vip_coupon_tip"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:layout_marginEnd="6dp"
                android:paddingVertical="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="10sp"
                android:textColor="@color/sys_white"
                android:layout_gravity="center_vertical"
                android:id="@+id/bt_vip_coupon_use"
                android:layout_width="54dp"
                android:layout_height="28dp"
                android:text="去使用"
                android:backgroundTint="@color/sys_red"
                style="@style/M3IconWithText"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/bt_close_coupon_tip"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ico_jiguang_close"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vip_coupon_use2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vip_coupon_content_2"
            android:background="@drawable/bg_red_round_5"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp">
            <TextView
                android:textSize="40dp"
                android:textStyle="bold"
                android:textColor="@color/sys_white"
                android:id="@+id/tv_vip_coupon_tip2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/tv_vip_coupon_tip3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/sys_white"
                android:id="@+id/tv_vip_coupon_tip3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_vip_coupon_tip2"
                app:layout_constraintBaseline_toBottomOf="@+id/tv_vip_coupon_tip2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_vip_coupon_tip2"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/sys_red"
                android:id="@+id/tv_vip_coupon_tip4"
                android:background="@drawable/bg_red_round_3"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:paddingHorizontal="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tv_vip_coupon_tip5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_vip_coupon_tip2"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/sys_white"
                android:id="@+id/tv_vip_coupon_tip5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:text=":"
                android:layout_marginHorizontal="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tv_vip_coupon_tip6"
                app:layout_constraintStart_toEndOf="@+id/tv_vip_coupon_tip4"
                app:layout_constraintTop_toTopOf="@+id/tv_vip_coupon_tip4"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/sys_red"
                android:id="@+id/tv_vip_coupon_tip6"
                android:background="@drawable/bg_red_round_3"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_vip_coupon_tip5"
                app:layout_constraintTop_toTopOf="@+id/tv_vip_coupon_tip4"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bt_close_coupon_tip2"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ico_close_2"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <include
        android:id="@+id/debug_panel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/view_log_catch"/>
</androidx.constraintlayout.widget.ConstraintLayout>

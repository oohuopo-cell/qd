<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tvTeamSpaceInputHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_1x"/>
    <EditText
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/etTeamSpaceInput"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_height_l"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:paddingStart="@dimen/space_2x"
        android:paddingEnd="@dimen/space_2x"
        android:backgroundTint="@color/sys_gray6"/>
</LinearLayout>

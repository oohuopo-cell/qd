<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/shape_bg_white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space_top"/>
    <Space
        android:id="@+id/space_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_top"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_tips"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/btn_wechat"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:backgroundTint="@color/sys_blue"
        android:layout_marginHorizontal="16dp"
        app:icon="@drawable/ico_wechat"
        app:iconGravity="textStart"
        app:iconSize="30dp"
        app:iconTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"
        style="@style/CommonButton"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/sys_white"
        android:id="@+id/btn_tiktok"
        android:visibility="gone"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/vip_to_tiktok"
        android:backgroundTint="@color/sys_black"
        android:layout_marginHorizontal="16dp"
        app:icon="@drawable/ico_tiktok"
        app:iconGravity="textStart"
        app:iconTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_wechat"
        style="@style/CommonButton"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_open_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_tiktok"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/vip_golden"
        android:id="@+id/btn_open_vip"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:backgroundTint="@color/vip_bg"
        android:layout_marginHorizontal="16dp"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_tips"
        style="@style/CommonButton"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/sys_gray2"
        android:id="@+id/tv_close"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/vip_close"
        android:layout_marginHorizontal="16dp"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_open_vip"
        style="@style/CommonButton"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_close"/>
</androidx.constraintlayout.widget.ConstraintLayout>

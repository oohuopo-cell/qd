<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/csl_verify_code"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_verify_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_marginEnd="@dimen/margin2x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/large_text_size"
                android:textStyle="bold"
                android:textColor="@color/sys_black"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2x"
                android:text="@string/login_phone_sms_code_tint"/>
            <TextView
                android:id="@+id/tv_send_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/login_phone_sms_tip_send_to"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x">
                <EditText
                    android:textSize="@dimen/text_body_m"
                    android:textColor="@color/sys_black"
                    android:textColorHint="@color/sys_gray1"
                    android:id="@+id/vciv_code3"
                    android:background="@drawable/bg_white_radius24"
                    android:paddingLeft="@dimen/icon_s_20"
                    android:paddingRight="@dimen/icon_s_20"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_6x"
                    android:hint="@string/login_phone_sms_code_tint"
                    android:singleLine="true"
                    android:maxLength="6"
                    android:inputType="phone"
                    android:backgroundTint="@color/sys_gray6"
                    android:paddingHorizontal="@dimen/icon_s_20"
                    android:importantForAutofill="no"/>
                <TextView
                    android:textSize="@dimen/medium_text_size"
                    android:textColor="@color/sys_gray1"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/tv_count_down_resent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin2x"/>
                <TextView
                    android:textSize="@dimen/medium_text_size"
                    android:textColor="@color/sys_blue"
                    android:gravity="center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/bt_resent"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/login_phone_sms_code_resent"
                    android:layout_marginEnd="@dimen/margin2x"/>
            </FrameLayout>
            <TextView
                android:textColor="@color/sys_red"
                android:id="@+id/tv_tip_sms_code_err"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/login_phone_sms_code_error"/>
            <TextView
                android:enabled="false"
                android:id="@+id/tv_code_complete"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/login_text"
                style="@style/LoginPrimaryButton"/>
            <TextView
                android:textColor="@color/sys_white"
                android:id="@+id/tv_bind_phone_back"
                android:background="@drawable/select_round_blue_grey"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/setting_profile_bind_phone_back"
                android:backgroundTint="@color/sys_red"
                style="@style/LoginPrimaryButton"/>
        </LinearLayout>
        <include
            android:id="@+id/layout_third_party"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/layout_login_third_party"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/activity_login_progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/icon_display_60"
        android:layout_height="@dimen/icon_display_60"/>
</FrameLayout>

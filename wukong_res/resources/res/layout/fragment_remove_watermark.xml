<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/margin2x"
    android:layout_marginRight="@dimen/margin2x"
    android:layout_marginHorizontal="@dimen/margin2x">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/sys_gray1"
        android:ellipsize="end"
        android:id="@+id/tv_paste_content"
        android:background="@drawable/shape_bg_white"
        android:padding="@dimen/margin2x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:minHeight="160dp"
        android:maxLines="5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_clear"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin2x"
        android:text="@string/clear"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/tv_paste_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_paste_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_paste"
        android:background="@drawable/shape_bg_sysgray6_r20"
        android:paddingLeft="@dimen/space_3x"
        android:paddingTop="13dp"
        android:paddingRight="@dimen/space_3x"
        android:paddingBottom="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/watermark_paste"
        android:drawablePadding="@dimen/space_0_5x"
        android:drawableStart="@drawable/icon_paste"
        android:paddingHorizontal="@dimen/space_3x"
        android:paddingVertical="13dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_paste_content"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/watermark_paste_tip"
        app:layout_constraintBottom_toBottomOf="@+id/tv_paste_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_paste_content"
        app:layout_constraintStart_toStartOf="@+id/tv_paste_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_paste"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_white"
        android:gravity="center"
        android:id="@+id/tv_remove_watermark"
        android:background="@drawable/select_round_blue_grey"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/watermark_click_remove"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@+id/tv_paste_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_course"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/watermark_get_course"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_remove_watermark"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/sys_gray1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/layout_height_xs"
        android:text="@string/watermark_statement"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_paste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_paste, tv_tip"/>
</androidx.constraintlayout.widget.ConstraintLayout>

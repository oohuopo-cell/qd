<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_gray6"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/icon"
        android:background="@color/sys_gray6"
        android:layout_width="@dimen/icon_xl_60"
        android:layout_height="@dimen/icon_xl_60"
        android:src="@drawable/ico_app_icon_default_90"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/SpRoundedStyleCorner12"/>
    <info.red.virtual.widget.TwoTextViewGroup
        android:orientation="horizontal"
        android:id="@+id/name_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/change_version"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/abi"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/transparent_black_00"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/sys_red"
                    android:gravity="center"
                    android:id="@+id/abi_text"
                    android:background="@color/sys_red_20"
                    android:padding="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </info.red.virtual.widget.TwoTextViewGroup>
    <TextView
        android:textSize="12sp"
        android:id="@+id/version"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/name_group"
        app:layout_constraintTop_toBottomOf="@+id/name_group"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/anchor"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/xm_name"
        app:layout_constraintStart_toStartOf="@+id/name_group"
        app:layout_constraintTop_toBottomOf="@+id/name_group"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/sys_blue"
        android:id="@+id/bt_blue_1"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/name_group"
        app:layout_constraintTop_toBottomOf="@+id/version"
        app:layout_goneMarginTop="8dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/sys_blue"
        android:id="@+id/bt_blue_2"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/bt_blue_1"
        app:layout_constraintTop_toTopOf="@+id/bt_blue_1"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/sys_blue"
        android:id="@+id/bt_blue_3"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/bt_blue_2"
        app:layout_constraintTop_toTopOf="@+id/bt_blue_1"/>
    <FrameLayout
        android:id="@+id/change_version"
        android:background="@drawable/bg_app_menu_download_progress"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/name_group">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sys_blue"
            android:gravity="center"
            android:id="@+id/change_version_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="14dp"
            android:gravity="center"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="切换旧版"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sys_blue"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/change_version_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_input"
        android:background="@color/sys_white"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="16sp"
            android:textColor="@color/sys_black"
            android:textColorHint="@color/sys_gray1"
            android:id="@+id/et_input"
            android:background="@drawable/message_rect_input_bg"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="112dp"
            android:hint="@string/message_input_hint"
            android:maxLength="1000"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/btn_send"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="16dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/sys_white"
            android:id="@+id/btn_send"
            android:background="@drawable/bg_msg_send"
            android:paddingLeft="13dp"
            android:paddingTop="@dimen/space_1x"
            android:paddingRight="13dp"
            android:paddingBottom="@dimen/space_1x"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_send"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="@dimen/space_1x"
            app:layout_constraintBottom_toBottomOf="@+id/et_input"
            app:layout_constraintEnd_toStartOf="@+id/iv_more"
            app:layout_constraintTop_toTopOf="@+id/et_input"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_more"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_chat_more"
            android:tint="@color/sys_black"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_input"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/use_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_below="@+id/cl_input"/>
</merge>

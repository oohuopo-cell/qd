<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_user_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/sys_white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_height_l"
            android:layout_marginTop="@dimen/margin1x">
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ux"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin2x"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sb_user_plan"
                android:layout_width="@dimen/space_6x"
                android:layout_height="@dimen/space_3x"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/margin2x"
                android:layout_alignParentEnd="true"
                app:colorControlActivated="@color/sys_blue"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_plan_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin2x"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginRight="@dimen/margin2x"
            android:layout_marginBottom="@dimen/margin1x"
            android:lineSpacingExtra="@dimen/stroke_width_default"
            android:layout_marginHorizontal="@dimen/margin2x"
            android:layout_marginVertical="@dimen/margin1x"/>
    </LinearLayout>
</LinearLayout>

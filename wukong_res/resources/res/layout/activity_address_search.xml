<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <info.red.virtual.standardui.widget.WkSearchBar
        android:id="@+id/address_search_sv_cloud_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        app:layout_constraintTop_toTopOf="parent"
        app:wkSearchHint="@string/enter_loc"
        app:wkSearchMode="bar"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/address_search_section_header"
        android:paddingLeft="@dimen/margin2x"
        android:paddingRight="@dimen/margin2x"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:paddingHorizontal="@dimen/margin2x"
        app:layout_constraintTop_toBottomOf="@+id/address_search_sv_cloud_search">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:gravity="center_vertical"
            android:id="@+id/address_search_tv_section_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_gray1"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/address_search_tv_space_hint"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/location_search_space_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/margin1x"
            android:paddingEnd="0dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/address_search_rv_Loc_search"
        android:paddingLeft="@dimen/icon_s_20"
        android:paddingRight="@dimen/icon_s_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/icon_s_20"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/address_search_section_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/address_search_history_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/address_search_sv_cloud_search">
        <include
            android:id="@+id/history_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_wk_history_header"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/address_search_rv_recommend_Loc_search"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

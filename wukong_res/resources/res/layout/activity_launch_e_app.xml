<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_gray6"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/actLaunchApp_ilTop"
        layout="@layout/layout_essential_toolbar"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/activity_launch_app_progressbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_below="@+id/actLaunchApp_ilTop"
        app:hideAnimationBehavior="inward"
        app:indeterminateAnimationType="contiguous"
        app:indicatorColor="@array/rainbow_animation"
        app:indicatorDirectionLinear="rightToLeft"
        app:showAnimationBehavior="outward"/>
    <ImageView
        android:id="@+id/actLaunchApp_ivLogo"
        android:layout_width="@dimen/layout_height_xxl"
        android:layout_height="@dimen/layout_height_xxl"
        android:src="@drawable/wk_icon"
        android:layout_above="@+id/actLaunchApp_tvLaunch"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_title_m"
        android:textColor="@color/sys_black"
        android:id="@+id/actLaunchApp_tvLaunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/launch_e_app_tip_running"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="@dimen/text_title_m"
        android:textColor="@color/sys_gray1"
        android:layout_gravity="center"
        android:id="@+id/actLaunchApp_tvTip"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin3x"
        android:text="@string/launch_e_app_tip_description"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="@dimen/margin1x"/>
</RelativeLayout>

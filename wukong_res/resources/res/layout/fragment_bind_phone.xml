<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:paddingTop="@dimen/margin2x"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/margin2x"
    android:paddingEnd="@dimen/margin2x">
    <TextView
        android:textSize="@dimen/large_text_size"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting_profile_phone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/setting_profile_phone_tip_bind"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_6x"
        android:layout_marginTop="@dimen/space_3x"
        android:backgroundTint="@color/sys_gray6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:id="@+id/tv_qu"
        android:layout_width="@dimen/space_8x"
        android:layout_height="wrap_content"
        android:text="@string/login_phone_sms_86"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <EditText
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:id="@+id/et_phone"
        android:background="@null"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/login_phone_sms_phone_tint"
        android:singleLine="true"
        android:maxLength="11"
        android:inputType="number"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="@dimen/space_1x"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toStartOf="@+id/bt_clear_et"
        app:layout_constraintStart_toEndOf="@+id/tv_qu"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <ImageView
        android:id="@+id/bt_clear_et"
        android:padding="@dimen/space_1_5x"
        android:visibility="invisible"
        android:layout_width="@dimen/space_6x"
        android:layout_height="@dimen/space_6x"
        android:src="@mipmap/ico_close_72"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:id="@+id/btn_get_verifycode"
        android:background="@drawable/select_round_blue_grey"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_6x"
        android:layout_marginTop="@dimen/margin3x"
        android:text="@string/login_phone_sms_phone_get_code"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>

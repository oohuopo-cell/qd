<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/permission_list_top_ll"
    android:background="@color/sys_red"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x">
        <ImageView
            android:id="@+id/ivBack"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ico_back_gray_90"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/margin2x"
            android:paddingEnd="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textStyle="bold"
            android:textColor="@color/sys_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_permission"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_height_xs">
        <TextView
            android:textSize="40sp"
            android:textColor="@color/sys_white"
            android:gravity="bottom"
            android:id="@+id/tvNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_0_5x"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_white"
            android:gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_title_l"
        android:textColor="@color/sys_white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvBigTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/permission_list_big_title_1"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/transparent_white_50"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_0_5x"
        android:layout_marginBottom="@dimen/layout_height_xs"
        android:text="@string/open_now"/>
</LinearLayout>

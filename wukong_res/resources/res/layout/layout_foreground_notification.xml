<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/layout_foreground_notification_logo_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/sys_black"
            android:id="@+id/layout_foreground_notification_tip_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/sys_gray1"
            android:id="@+id/layout_foreground_notification_content_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/layout_foreground_notification_close_iv"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ico_dlg_close_144"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
</LinearLayout>

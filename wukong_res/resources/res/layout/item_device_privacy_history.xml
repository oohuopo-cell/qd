<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/sys_white"
    android:paddingLeft="@dimen/icon_s_20"
    android:paddingRight="@dimen/icon_s_20"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_6x"
    android:paddingHorizontal="@dimen/icon_s_20">
    <TextView
        android:textSize="@dimen/text_note_m"
        android:textColor="@color/sys_gray1"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_device_privacy_history_time"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/space_2x"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_device_privacy_history_name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/tv_device_privacy_history_time"
        android:layout_alignParentStart="true"/>
</RelativeLayout>

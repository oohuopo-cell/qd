<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_essential_toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:fillViewport="true"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/activity_about_ivLogo"
                android:layout_width="@dimen/layout_height_xxl"
                android:layout_height="@dimen/layout_height_xxl"
                android:layout_marginTop="@dimen/margin2x"
                android:src="@drawable/wk_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/text_title_l"
                android:textStyle="bold"
                android:textColor="@color/sys_blue"
                android:id="@+id/activity_about_tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin1x"
                android:text="@string/xm_name"
                android:layout_below="@+id/activity_about_ivLogo"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_black"
                android:id="@+id/activity_about_tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v10.0.0"
                android:layout_below="@+id/activity_about_tvAppName"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin1x"
                android:layout_below="@+id/activity_about_tvVersion">
                <TextView
                    android:id="@+id/activity_about_tvContact"
                    android:text="@string/contact_us"
                    style="@style/LinearLayoutTextView"/>
                <View style="@style/LayoutLine"/>
                <TextView
                    android:id="@+id/activity_about_tvGood"
                    android:text="@string/encourage"
                    style="@style/LinearLayoutTextView"/>
                <View style="@style/LayoutLine"/>
                <TextView
                    android:id="@+id/activity_about_tvRecommend"
                    android:visibility="gone"
                    android:text="@string/title_user_recommend"
                    style="@style/LinearLayoutTextView"/>
                <View
                    android:visibility="gone"
                    style="@style/LayoutLine"/>
                <TextView
                    android:id="@+id/activity_about_tvMail"
                    android:text="@string/service_mail"
                    style="@style/LinearLayoutTextView"/>
                <View style="@style/LayoutLine"/>
                <TextView
                    android:id="@+id/activity_about_tvDouyinOfficial"
                    android:text="@string/follow_douyin_wukong_official"
                    style="@style/LinearLayoutTextView"/>
                <View style="@style/LayoutLine"/>
                <TextView
                    android:id="@+id/activity_about_tvDouyinAuthor"
                    android:text="@string/follow_douyin_kaifenshen_author"
                    style="@style/LinearLayoutTextView"/>
                <View style="@style/LayoutLine"/>
                <TextView
                    android:id="@+id/tv_update"
                    android:text="@string/about_update"
                    style="@style/LinearLayoutTextView"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/margin1x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_note_m"
                android:textColor="@color/sys_blue"
                android:id="@+id/activity_aboutus_tvprivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy"/>
            <TextView
                android:textColor="@color/sys_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/and_en_copyright"/>
            <TextView
                android:textSize="@dimen/text_note_m"
                android:textColor="@color/sys_blue"
                android:id="@+id/activity_aboutus_useragentment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_agentment"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bt_icp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_note_m"
                android:textColor="@color/sys_gray1"
                android:gravity="center"
                android:id="@+id/activity_about_tv_icp"
                android:paddingTop="@dimen/space_1x"
                android:paddingBottom="@dimen/space_1x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ICP备案号：闽ICP备19009574号-9A"
                android:paddingVertical="@dimen/space_1x"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@mipmap/icon_gray_arrow_right"
                android:layout_width="@dimen/space_1_5x"
                android:layout_height="@dimen/space_1_5x"
                android:layout_marginTop="@dimen/space_0"
                android:layout_marginStart="@dimen/stroke_width_default"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_gray1"
            android:gravity="center"
            android:id="@+id/activity_about_tvKefu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_0_5x"
            android:text="@string/service_mail"/>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_gray1"
            android:gravity="center"
            android:id="@+id/activity_aboutus_techlz_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/com_techlz_copyright"/>
    </LinearLayout>
</LinearLayout>

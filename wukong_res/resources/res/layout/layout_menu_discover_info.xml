<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_menu_discover_info_menu_item_rl"
    android:background="@drawable/select_item_bg"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="@dimen/margin1x"
    android:paddingStart="@dimen/margin1x"
    android:paddingEnd="@dimen/margin1x">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/layout_menu_discover_info_icon_iv"
        android:padding="@dimen/space_0"
        android:layout_width="@dimen/layout_height_xs"
        android:layout_height="@dimen/layout_height_xs"
        android:scaleType="center"
        android:adjustViewBounds="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin1x"
        app:shapeAppearance="@style/SpRoundedStyle"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:textColorHighlight="@color/sys_gray6"
        android:ellipsize="end"
        android:id="@+id/layout_e_app_item_tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@android:string/unknownName"
        android:lines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        android:layout_toEndOf="@+id/layout_menu_discover_info_icon_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/layout_menu_discover_info_iv_arrow"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin1x"
        style="@style/RlStyleIcon.arrow"/>
    <ImageView
        android:id="@+id/layout_menu_discover_info_red_point_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_red_size8"
        android:layout_centerVertical="true"
        android:contentDescription="@android:string/unknownName"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/layout_menu_discover_info_right_pic_iv"
        android:visibility="gone"
        android:layout_width="@dimen/layout_height_xs"
        android:layout_height="@dimen/layout_height_xs"
        android:src="@drawable/select_round_blue"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        app:shapeAppearance="@style/SpRoundedStyle"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/layout_menu_discover_info_iv_ad_view"
        android:visibility="gone"
        android:layout_width="@dimen/layout_height_xs"
        android:layout_height="@dimen/layout_height_xs"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        app:shapeAppearance="@style/SpRoundedStyle"
        app:srcCompat="@drawable/select_round_blue"/>
    <TextView
        android:id="@+id/layout_menu_discover_info_right_gray_menu_sub_tv"
        android:visibility="gone"
        android:text="@android:string/unknownName"
        android:maxLength="99999"
        android:layout_toStartOf="@+id/layout_menu_discover_info_right_pic_iv"
        style="@style/RlStyleContent"/>
    <ImageView
        android:id="@+id/layout_menu_discover_info_right_pic_red_point_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:src="@drawable/bg_red_size8"
        android:contentDescription="@android:string/unknownName"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"/>
    <TextView
        android:id="@+id/layout_menu_discover_info_right_gray_menu_tv"
        android:visibility="gone"
        android:text="@android:string/unknownName"
        android:maxLength="99999"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        style="@style/RlStyleContent"/>
    <TextView
        android:id="@+id/layout_menu_discover_info_right_gray_menu_tv2"
        android:visibility="gone"
        android:text="@android:string/unknownName"
        android:maxLength="99999"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        style="@style/RlStyleContent"/>
    <TextView
        android:id="@+id/layout_menu_discover_info_red_bg_text_tv"
        android:visibility="gone"
        android:text="@android:string/unknownName"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        style="@style/RlStyleContent.RedBgTip"/>
    <TextView
        android:textColor="@color/sys_white"
        android:id="@+id/layout_menu_discover_info_red_number_tv"
        android:visibility="gone"
        android:text="1"
        android:layout_toStartOf="@+id/layout_menu_discover_info_iv_arrow"
        style="@style/RlStyleContent.RedBgNum"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/permission_list_top"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fra_permission_check_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray2"
                android:gravity="center_horizontal"
                android:paddingTop="@dimen/margin1x"
                android:paddingBottom="@dimen/margin1x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_support"/>
            <FrameLayout
                android:id="@+id/fragment_permission_list_fl_ad"
                android:background="@color/sys_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin1x"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

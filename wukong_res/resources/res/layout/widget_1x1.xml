<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_1_1_root_ll"
    android:layout_width="@dimen/icon_display_60"
    android:layout_height="@dimen/avatar_xxl_80">
    <GridLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_bg_widget"
        android:layout_width="@dimen/icon_display_60"
        android:layout_height="@dimen/icon_display_60"
        android:rowCount="4"
        android:columnCount="4">
        <ImageView
            android:id="@+id/app_1_1_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:layout_marginTop="@dimen/stroke_width_default"
            android:src="@drawable/wk_icon"
            android:layout_marginStart="@dimen/stroke_width_default"/>
        <ImageView
            android:id="@+id/app_1_2_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:layout_marginTop="@dimen/stroke_width_default"
            android:src="@drawable/wk_icon"/>
        <ImageView
            android:id="@+id/app_1_3_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:layout_marginTop="@dimen/stroke_width_default"
            android:src="@drawable/wk_icon"/>
        <ImageView
            android:id="@+id/app_2_1_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:src="@drawable/wk_icon"
            android:layout_marginStart="@dimen/stroke_width_default"/>
        <ImageView
            android:id="@+id/app_2_2_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:src="@drawable/wk_icon"/>
        <ImageView
            android:id="@+id/app_2_3_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:src="@drawable/wk_icon"/>
        <ImageView
            android:id="@+id/app_3_1_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:src="@drawable/wk_icon"
            android:layout_marginStart="@dimen/stroke_width_default"/>
        <ImageView
            android:id="@+id/app_3_2_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:src="@drawable/wk_icon"/>
        <ImageView
            android:id="@+id/app_3_3_iv"
            android:padding="@dimen/stroke_width_default"
            android:visibility="gone"
            android:layout_width="@dimen/space_2x"
            android:layout_height="@dimen/space_2x"
            android:src="@drawable/wk_icon"/>
    </GridLayout>
    <TextView
        android:textSize="@dimen/text_note_m"
        android:textColor="@color/sys_white"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_0_5x"
        android:text="@string/xm_name"
        android:shadowColor="@color/sys_black"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="2"/>
</LinearLayout>

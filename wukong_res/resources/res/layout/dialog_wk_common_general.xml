<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_white_radius20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DialogContentPadding1x">
        <TextView
            android:textSize="@dimen/text_title_m"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dialog_wk_common_general_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/dialog_wk_common_general_content_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"/>
        <FrameLayout
            android:id="@+id/dialog_wk_common_general_ad_content_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x">
            <info.red.virtual.standardui.widget.BtnIconTextView
                android:id="@+id/dialog_wk_common_general_yes_btn_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RadiusButton.large.dialog"/>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_white"
                android:gravity="center"
                android:id="@+id/progress"
                android:background="@drawable/bg_app_menu_download_progress2"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textAlignment="center"/>
        </FrameLayout>
        <TextView
            android:id="@+id/dialog_wk_common_general_cancel_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            style="@style/CancelRadiusButtonLargeDialog"/>
    </LinearLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/select_bg_syswhite_r2x"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/DialogContentPadding1x">
    <TextView
        android:textSize="@dimen/margin3x"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin3x"
        android:text="@string/dialog_title_tip"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_gray1"
        android:id="@+id/dialog_launch_notice_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin1x"/>
    <TextView
        android:id="@+id/dialog_launch_notice_i_known"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_i_got_it"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="@dimen/margin1x"
        style="@style/RadiusButton.large.dialog"/>
    <CheckBox
        android:textColor="@color/sys_gray1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_launch_notice_never_remind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:layout_marginBottom="@dimen/margin1x"
        android:text="@string/btn_not_remind"
        android:buttonTint="@color/sys_gray1"/>
</LinearLayout>

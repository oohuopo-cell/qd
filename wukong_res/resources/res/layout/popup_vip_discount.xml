<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:elevation="0dp"
    app:cardBackgroundColor="@color/sys_white"
    app:cardElevation="0dp"
    app:contentPadding="0dp"
    app:shapeAppearance="@style/TopRoundedCard"
    app:strokeWidth="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vip_amount_details"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ico_close_60"
            android:tint="@color/sys_gray1"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_total_price_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4x"
            android:text="@string/vip_total_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_total_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_total_price_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_total_price_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_total_reduction_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4x"
            android:text="@string/vip_total_reduction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_price_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textStyle="bold"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_total_reduction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_total_reduction_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_total_reduction_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_subsidy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4x"
            android:text="@string/vip_wk_subsidy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_reduction_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textStyle="bold"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_subsidy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_subsidy_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_subsidy_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_coupon_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4x"
            android:text="@string/vip_coupon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subsidy_title"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_white"
            android:id="@+id/tv_coupon_timeout"
            android:background="@drawable/timeout_bg"
            android:paddingLeft="@dimen/space_1x"
            android:paddingTop="@dimen/stroke_width_default"
            android:paddingRight="@dimen/space_1x"
            android:paddingBottom="@dimen/stroke_width_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="@dimen/space_1x"
            android:paddingVertical="@dimen/stroke_width_default"
            app:layout_constraintStart_toEndOf="@+id/tv_coupon_title"
            app:layout_constraintTop_toTopOf="@+id/tv_coupon_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_s"
            android:textStyle="bold"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_coupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_coupon_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_coupon_title"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_coupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_coupon, tv_coupon_timeout, tv_coupon_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

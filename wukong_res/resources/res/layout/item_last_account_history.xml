<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/avatar_xxl_80"
    android:layout_marginBottom="16dp"
    android:paddingHorizontal="16dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"
        app:cardBackgroundColor="@color/sys_gray6"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <View
            android:id="@+id/bg_vip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img"
        android:layout_width="@dimen/space_6x"
        android:layout_height="@dimen/space_6x"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/SpRoundedStyle.oval"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:textColor="@color/sys_red"
        android:id="@+id/tv_last"
        android:background="@drawable/bg_login_last"
        android:padding="@dimen/stroke_width_default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_last"
        android:translationY="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/img"
        app:layout_constraintEnd_toEndOf="@+id/img"
        app:layout_constraintStart_toStartOf="@+id/img"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/uid_and_login_way"
        app:layout_constraintEnd_toStartOf="@+id/icon_vip"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/img"
        app:layout_constraintTop_toTopOf="@+id/img"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon_vip"
        android:layout_width="@dimen/icon_s_20"
        android:layout_height="@dimen/icon_s_20"
        android:src="@mipmap/ico_account_vip"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/space_1x"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintEnd_toStartOf="@+id/already_login"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_white"
        android:id="@+id/already_login"
        android:paddingLeft="@dimen/space_1_5x"
        android:paddingTop="@dimen/space_1x"
        android:paddingRight="@dimen/space_1_5x"
        android:paddingBottom="@dimen/space_1x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_text"
        android:layout_marginEnd="@dimen/margin2x"
        android:backgroundTint="@color/sys_blue"
        android:paddingHorizontal="@dimen/space_1_5x"
        android:paddingVertical="@dimen/space_1x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_note_m"
        android:textColor="@color/sys_gray1"
        android:id="@+id/uid_and_login_way"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1x"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/img"
        app:layout_constraintStart_toEndOf="@+id/img"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/yun_layout_tab"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <WebView
            android:id="@+id/map_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/map_center_pin"
            android:layout_width="@dimen/space_3x"
            android:layout_height="@dimen/space_3x"
            android:src="@drawable/ic_map_pin_24"
            android:contentDescription="@null"
            android:translationY="-12dp"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/sys_white"
        android:paddingLeft="@dimen/margin2x"
        android:paddingTop="@dimen/margin1x"
        android:paddingRight="@dimen/margin2x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin2x">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/map_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/searching_location"
            android:maxLines="3"
            android:minLines="3"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_confirm"
            android:layout_marginTop="@dimen/margin1x"
            android:layout_marginBottom="@dimen/margin1x"
            android:text="@string/location_privacy_map_confirm"
            android:layout_marginVertical="@dimen/margin1x"
            style="@style/M3IconWithTextNoLimitMargin.Big"/>
    </LinearLayout>
</LinearLayout>

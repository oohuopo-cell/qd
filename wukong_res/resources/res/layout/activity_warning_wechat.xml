<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ico_jiguang_close"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/sys_black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="危险"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/ico_warning"
        android:layout_marginVertical="30dp"/>
    <ScrollView
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/sys_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="微信不支持一台设备同时登录多个账号。关闭防串号功能，后台同时多开微信，可能导致："/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/sys_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="1. 微信被限制登录\10\102. 部分功能无法使用\10\103. 其他账号异常问题"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/checkbox"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <View
            android:enabled="true"
            android:id="@+id/checkbox_img"
            android:background="@drawable/select_vip_privacy_checkbox"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/sys_black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我已知晓可能存在的风险，并自愿承担可能导致的后果"
            android:layout_marginStart="26dp"/>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:textColor="@color/sys_black"
        android:id="@+id/ok"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        style="@style/AppDetailBottomButton.Big"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/sys_black"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:text="取消"
        android:backgroundTint="@color/sys_gray6"
        android:layout_marginHorizontal="16dp"
        style="@style/AppDetailBottomButton.Big"/>
</LinearLayout>

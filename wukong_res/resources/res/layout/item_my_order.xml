<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_white"
    android:padding="@dimen/margin2x"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin1x"
    android:layout_marginStart="@dimen/margin2x"
    android:layout_marginEnd="@dimen/margin2x">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_order_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_order_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_order_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_order_create_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_order_pay_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_order_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/sys_gray2"
        android:id="@+id/tv_order_pay_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:id="@+id/tv_order_action_copy"
            android:background="@drawable/select_round_gray6"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="72dp"
            android:text="@string/my_order_copy_pay_id"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/sys_white"
            android:gravity="center"
            android:id="@+id/tv_order_action_renew"
            android:background="@drawable/shape_btn_sysblue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="72dp"
            android:text="@string/vip_renew"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="@dimen/margin1x"/>
    </LinearLayout>
</LinearLayout>

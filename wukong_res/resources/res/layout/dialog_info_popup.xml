<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_bg_sysgray6_r1x"
        android:layout_width="@dimen/space_0"
        android:layout_height="@dimen/icon_display_60"
        app:layout_constraintDimensionRatio="180:56"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_popup_desktop"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:text="@string/str_popup_desktop"
            android:drawablePadding="@dimen/stroke_width_default"
            android:layout_weight="1"
            app:drawableTopCompat="@mipmap/ico_general_desktop_90"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_popup_top"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:text="@string/tip_stick_top"
            android:drawablePadding="@dimen/stroke_width_default"
            android:layout_weight="1"
            app:drawableTopCompat="@mipmap/ico_general_top_90"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_popup_uninstall"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:text="@string/eapp_uninstall"
            android:drawablePadding="@dimen/stroke_width_default"
            android:layout_weight="1"
            app:drawableTopCompat="@mipmap/ico_general_delete_90"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

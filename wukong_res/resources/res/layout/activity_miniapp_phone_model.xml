<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/main"
            android:visibility="invisible"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin2x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/activity_emu_device_rlSearchDevice"
                    android:background="@drawable/select_bg_syswhite_r2x"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_4x"
                    android:layout_marginTop="@dimen/margin1x"
                    android:layout_marginBottom="@dimen/margin1x"
                    android:layout_marginStart="@dimen/margin2x"
                    android:layout_marginEnd="@dimen/margin2x">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/ico_search_60"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/margin1x"/>
                    <TextView
                        android:textSize="@dimen/text_body_s"
                        android:textColor="@color/sys_gray2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_device"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/space_5x"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/sys_white"
                    android:paddingTop="@dimen/margin2x"
                    android:paddingBottom="@dimen/margin2x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin2x"
                        android:layout_marginEnd="@dimen/margin2x">
                        <TextView
                            android:textColor="@color/sys_blue"
                            android:id="@+id/activity_emu_device_tvChangeParam"
                            android:padding="@dimen/margin1x"
                            android:visibility="gone"
                            android:layout_width="@dimen/space_0"
                            android:layout_height="wrap_content"
                            android:text="换参数"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/strokeWidth"
                            style="@style/CancelRadiusButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/activity_emu_device_tvChangeBrand"
                            android:layout_marginTop="@dimen/margin1x"
                            android:layout_marginBottom="@dimen/margin1x"
                            android:layout_marginVertical="@dimen/margin1x"
                            style="@style/M3IconWithTextNoLimitMargin.Big"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin1x"
                        android:layout_marginStart="@dimen/margin2x"
                        android:layout_marginEnd="@dimen/margin2x">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/activity_emu_device_tvChangeBrand2"
                            android:layout_marginTop="@dimen/margin1x"
                            android:layout_marginBottom="@dimen/margin1x"
                            android:layout_marginVertical="@dimen/margin1x"
                            style="@style/M3IconWithTextNoLimitMargin.Big"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_body_m"
                    android:textColor="@color/sys_gray1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin2x"
                    android:text="@string/device_privacy_pro_params"
                    android:layout_marginStart="@dimen/margin2x"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/activity_emu_device_rcParam"
                    android:background="@color/sys_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin2x"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <include
                    android:id="@+id/history_header"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin2x"
                    layout="@layout/include_wk_history_header"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/device_privacy_history_list"
                    android:background="@color/sys_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="头像"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_head"
            android:layout_width="@dimen/space_5x"
            android:layout_height="@dimen/space_5x"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"
            app:shapeAppearance="@style/SpRoundedStyle.oval"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户名称"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户ID"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_userid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="联系方式"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_models"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="机型等"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:gravity="end"
            android:id="@+id/tv_ext_1"
            android:paddingTop="@dimen/margin2x"
            android:paddingBottom="@dimen/margin2x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_models"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分身应用"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:gravity="end"
            android:id="@+id/tv_ext_2"
            android:paddingTop="@dimen/margin2x"
            android:paddingBottom="@dimen/margin2x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_apps"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/login_contact_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@mipmap/ico_back_gray_90"
        app:titleCentered="true"/>
    <RelativeLayout
        android:background="@color/sys_white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp">
        <ImageView
            android:id="@+id/iv_clean_txt"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ico_clean_image_60"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin2x"
            android:layout_alignParentEnd="true"/>
        <EditText
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:textColorHint="@color/sys_gray1"
            android:id="@+id/et_contact"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="请输入您的微信/QQ/邮箱"
            android:singleLine="true"
            android:paddingStart="23dp"
            android:layout_marginEnd="@dimen/space_1x"
            android:layout_toStartOf="@+id/iv_clean_txt"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_gray1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1x"
        android:text="请填写您的联系方式，方便后续遇到问题我们可以及时和您取得联系。联系方式是保密的，我们将保护您隐私的安全不会泄露。"
        android:layout_marginStart="@dimen/space_1x"
        android:layout_marginEnd="30dp"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:gravity="center"
        android:id="@+id/btv_commit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="75dp"
        android:text="提交"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/margin2x"
        android:layout_marginEnd="@dimen/margin2x"
        android:stateListAnimator="@null"
        style="@style/RadiusButton.large.dialog"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_gray1"
        android:layout_gravity="center"
        android:id="@+id/tv_skip"
        android:padding="@dimen/margin2x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳过"/>
</LinearLayout>

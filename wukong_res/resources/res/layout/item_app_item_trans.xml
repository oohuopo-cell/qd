<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/icon_display_60">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin2x">
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/app_icon"
            android:layout_width="@dimen/space_5x"
            android:layout_height="@dimen/space_5x"
            android:scaleType="fitXY"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/wk_icon"
            android:background="@drawable/wk_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/tip"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="最多人使用"
        android:maxLength="6"
        android:layout_marginEnd="16dp"/>
</LinearLayout>

    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="@dimen/icon_display_60"
    android:layout_height="@dimen/space_6x"
    android:layout_marginEnd="@dimen/margin1x">
    <ImageView
        android:layout_width="@dimen/space_3x"
        android:layout_height="@dimen/space_3x"
        android:layout_marginTop="@dimen/space_0_5x"
        android:src="@mipmap/ico_batch_shortcut"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="@dimen/text_caption"
        android:textColor="@color/sys_gray1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="批量放桌面"/>
</LinearLayout>

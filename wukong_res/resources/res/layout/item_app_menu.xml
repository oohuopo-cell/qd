<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="8dp">
    <ImageView
        android:id="@+id/icon"
        android:padding="@dimen/space_0"
        android:layout_width="@dimen/layout_height_xs"
        android:layout_height="@dimen/layout_height_xs"
        android:scaleType="center"
        android:adjustViewBounds="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/margin1x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:lines="1"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_goneMarginStart="12dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrow"
        android:visibility="invisible"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RlStyleIcon.arrow"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/title2"
        android:visibility="invisible"
        android:maxLines="1"
        android:lines="1"
        android:maxLength="13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RlStyleContent.RedBgTip"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/title3"
        android:visibility="invisible"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"
        android:maxLength="13"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        style="@style/RlStyleContent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="title3,title2"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center"
        android:id="@+id/switch1"
        android:layout_width="48dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/app_detail_menu_switch"/>
</androidx.constraintlayout.widget.ConstraintLayout>

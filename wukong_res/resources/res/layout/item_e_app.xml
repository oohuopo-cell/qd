<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:paddingTop="@dimen/margin1x"
    android:paddingBottom="@dimen/margin1x"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/select_tr25"
    android:paddingVertical="@dimen/margin1x">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/item_e_app_rl_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:elevation="0dp"
            app:cardBackgroundColor="@color/transparent_black_00"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <View
                android:id="@+id/mask"
                android:background="@color/sys_black"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:alpha="0.5"/>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x">
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/icon_info"
                android:background="@drawable/icon_info"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/icon_today_unused_dot"
                android:background="@drawable/bg_clone_unused_dot"
                android:visibility="gone"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:id="@+id/item_e_app_tv_Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WkMediumSubTextStyle"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/item_e_app_tv_LocationIn"
        android:background="@drawable/shape_btn_tr50"
        android:paddingTop="@dimen/strokeWidth"
        android:paddingBottom="@dimen/strokeWidth"
        android:visibility="gone"
        android:layout_width="@dimen/layout_height_xxl"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/tip_location_on"
        android:lines="1"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/margin1x"
        android:paddingEnd="@dimen/margin1x"/>
</RelativeLayout>

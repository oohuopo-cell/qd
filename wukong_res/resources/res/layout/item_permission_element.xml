<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/select_bg_syswhite"
    android:paddingTop="@dimen/margin1x"
    android:paddingBottom="@dimen/margin1x"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margin2x"
    android:paddingEnd="@dimen/margin2x">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/margin1x">
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:ellipsize="end"
            android:id="@+id/item_permission_ele_tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:ellipsize="end"
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/stroke_width_default"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_body_s"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/btnSetting"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/to_turn_on"
            style="@style/RadiusButton.large"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray2"
            android:id="@+id/tvTextSetting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/to_settings"/>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_menu_discover_switch_root"
    android:background="@drawable/select_item_bg"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="@dimen/margin1x"
    android:paddingStart="@dimen/margin1x"
    android:paddingEnd="@dimen/margin1x">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/layout_menu_discover_switch_icon_iv"
        android:layout_width="@dimen/layout_height_xs"
        android:layout_height="@dimen/layout_height_xs"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin1x"
        app:shapeAppearance="@style/SpRoundedStyle"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:id="@+id/layout_menu_discover_switch_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/layout_menu_discover_switch_btn"
        android:layout_toEndOf="@+id/layout_menu_discover_switch_icon_iv"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/layout_menu_discover_switch_btn"
        android:layout_width="48dp"
        android:layout_height="28dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_alignParentEnd="true"
        style="@style/app_detail_menu_switch"/>
</RelativeLayout>

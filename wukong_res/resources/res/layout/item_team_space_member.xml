<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/select_item_bg"
    android:paddingTop="@dimen/margin1x"
    android:paddingBottom="@dimen/margin1x"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin1x"
    android:minHeight="52dp"
    android:paddingStart="@dimen/margin1x"
    android:paddingEnd="@dimen/margin1x">
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:ellipsize="end"
        android:id="@+id/tvTeamMemberRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin1x"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/tvTeamMemberUid"/>
    <TextView
        android:id="@+id/tvTeamMemberUid"
        android:maxLength="20"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_toStartOf="@+id/llTeamMemberActions"
        style="@style/RlStyleContent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llTeamMemberActions"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin1x"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_red"
            android:gravity="center"
            android:id="@+id/tvTeamMemberSecondaryAction"
            android:paddingTop="@dimen/res_0x7f07024c_margin0_5x"
            android:paddingBottom="@dimen/res_0x7f07024c_margin0_5x"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/res_0x7f07024c_margin0_5x"
            android:paddingEnd="@dimen/res_0x7f07024c_margin0_5x"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_blue"
            android:gravity="center"
            android:id="@+id/tvTeamMemberPrimaryAction"
            android:paddingTop="@dimen/res_0x7f07024c_margin0_5x"
            android:paddingBottom="@dimen/res_0x7f07024c_margin0_5x"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/res_0x7f07024c_margin0_5x"
            android:paddingEnd="@dimen/res_0x7f07024c_margin0_5x"
            android:layout_marginStart="@dimen/margin1x"/>
    </LinearLayout>
</RelativeLayout>

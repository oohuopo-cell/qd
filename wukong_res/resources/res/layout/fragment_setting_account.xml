<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_profile_header"
        android:background="@color/sys_white"
        android:padding="@dimen/margin2x"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_profile_avatar"
            android:layout_width="@dimen/avatar_xl_64"
            android:layout_height="@dimen/avatar_xl_64"
            android:src="@mipmap/ico_more_head_144"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/SpRoundedStyle.oval"/>
        <TextView
            android:textSize="@dimen/text_title_l"
            android:textStyle="bold"
            android:textColor="@color/sys_black"
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_profile_uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_profile_login_way"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin1x"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_vip_expire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x">
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tv_profile_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_note_m"
                android:gravity="center"
                android:id="@+id/tv_profile_refresh"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:text="@string/setting_profile_refresh"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"
                android:layout_marginStart="@dimen/margin1x"
                style="@style/RadiusButton"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_setting"
        android:background="@color/sys_gray6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin1x"
        app:layout_constraintBottom_toTopOf="@+id/tv_logout"
        app:layout_constraintEnd_toEndOf="@+id/layout_profile_header"
        app:layout_constraintStart_toStartOf="@+id/layout_profile_header"
        app:layout_constraintTop_toBottomOf="@+id/layout_profile_header"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_white"
        android:gravity="center"
        android:id="@+id/tv_logout"
        android:background="@drawable/select_round_blue"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_6x"
        android:layout_marginBottom="@dimen/margin2x"
        android:text="@string/login_out"
        android:layout_marginStart="@dimen/margin2x"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

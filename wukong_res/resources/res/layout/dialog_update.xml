<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/dialog_update_llDlg"
        android:background="@drawable/shape_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_5x"
        android:layout_marginEnd="@dimen/space_5x">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_0"
            android:src="@mipmap/ico_bg_update_840"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/dialog_update_ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ico_dlg_close_white_144"
            android:layout_marginEnd="@dimen/space_0_5x"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/dialog_update_llUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin2x"
            android:layout_marginStart="@dimen/margin2x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/text_title_l"
                android:textColor="@color/sys_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/dialog_update_tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发现新版本"/>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_white"
                android:gravity="center"
                android:id="@+id/tvUpdateVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5x"
                android:text="V11.0.0"
                android:lines="1"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:id="@+id/dialog_update_tips_content"
            android:padding="@dimen/margin1x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="有最新版本啦，快来更新～"
            android:lineSpacingExtra="@dimen/space_0_5x"
            app:layout_constraintBottom_toTopOf="@+id/rlUpdateBottom"
            app:layout_constraintTop_toBottomOf="@+id/dialog_update_llUpdate"
            app:layout_constraintVertical_bias="0.65"/>
        <FrameLayout
            android:id="@+id/rlUpdateBottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin2x"
            android:layout_marginStart="@dimen/margin2x"
            android:layout_marginEnd="@dimen/margin2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ProgressBar
                android:id="@+id/dialog_update_progressBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progressbar_horizontal_update"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/text_title_m"
                android:gravity="center"
                android:id="@+id/dialog_update_btn_ok"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/updating"
                app:backgroundTint="@color/sys_blue"
                style="@style/RadiusButton.large"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>

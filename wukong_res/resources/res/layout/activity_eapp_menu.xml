<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        android:id="@+id/top_toolbar"
        android:background="@color/sys_gray6"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_eapp_detail_toolbar"
        app:navigationIcon="@mipmap/ic_back_light"
        app:navigationIconTint="@color/sys_gray1"
        app:title="@string/clone_detail_title"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Body1"
        app:titleTextColor="@color/sys_black"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        app:layout_constraintBottom_toTopOf="@+id/include_notice_bar"
        app:layout_constraintTop_toBottomOf="@+id/top_toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/sys_white"
            android:fadingEdge="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/info"
                layout="@layout/layout_activity_menu_top"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/list"
                android:background="@color/sys_gray6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/sys_gray4"
                android:gravity="center_horizontal"
                android:id="@+id/version_text"
                android:background="@color/sys_gray6"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/include_notice_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/panel_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/view_persistent_notice_bar"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/panel_bottom"
        android:background="@color/sys_white"
        android:paddingLeft="@dimen/margin2x"
        android:paddingTop="@dimen/margin1x"
        android:paddingRight="@dimen/margin2x"
        android:paddingBottom="@dimen/margin1x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin2x"
        android:paddingVertical="@dimen/margin1x"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_bt"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_small_1"
                android:background="?attr/selectableItemBackground"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                style="@style/AppDetailBottomButton.Small"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_small_2"
                android:background="?attr/selectableItemBackground"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                style="@style/AppDetailBottomButton.Small"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin1x">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_big"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iconTint="@color/sys_white"
                    style="@style/AppDetailBottomButton.Big"/>
                <FrameLayout
                    android:id="@+id/bt_big_mask"
                    android:background="@color/sys_white"
                    android:focusable="true"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_install"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="安装分身"
                    style="@style/AppDetailBottomButton.Big"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/progress2"
                    android:background="@drawable/bg_app_menu_download_progress2"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textAlignment="center"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ProgressBar
        android:id="@+id/activity_eapp_progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/avatar_xxl_80"
        android:layout_height="@dimen/avatar_xxl_80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fake_splash"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wukonglauncher"
        android:scaleType="fitXY"/>
</androidx.constraintlayout.widget.ConstraintLayout>

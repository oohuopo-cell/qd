<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_essential_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/sys_white"
        android:padding="@dimen/padding1x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/activity_miniapp_versionName"
            style="@style/TvStyleTitleContent"/>
        <TextView
            android:id="@+id/activity_miniapp_versionCode"
            style="@style/TvStyleTitleContent"/>
        <TextView
            android:id="@+id/activity_miniapp_path"
            android:lineSpacingMultiplier="1.4"
            style="@style/TvStyleTitleContent"/>
    </LinearLayout>
    <ScrollView
        android:background="@color/sys_gray6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_5x">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_white"
                android:gravity="center"
                android:id="@+id/activity_miniapp_file"
                android:background="@drawable/shape_bg_white"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_5x"
                android:text="分身数据"
                android:layout_marginStart="@dimen/margin2x"
                android:layout_marginEnd="@dimen/margin2x"
                android:backgroundTint="@color/sys_green"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_body_m"
                android:textColor="@color/sys_white"
                android:gravity="center"
                android:id="@+id/activity_miniapp_user"
                android:background="@drawable/shape_bg_white"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_5x"
                android:layout_marginTop="@dimen/margin2x"
                android:layout_marginStart="@dimen/margin2x"
                android:layout_marginEnd="@dimen/margin2x"
                android:backgroundTint="@color/sys_blue"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

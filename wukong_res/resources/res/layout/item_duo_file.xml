<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/llFile_item"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <info.red.virtual.cusview.SmoothCheckBox
            android:id="@+id/checkbox_item"
            android:visibility="gone"
            android:layout_width="@dimen/icon_s_20"
            android:layout_height="@dimen/icon_s_20"
            android:layout_marginLeft="@dimen/space_1x"
            android:layout_marginRight="@dimen/space_1x"
            android:layout_marginHorizontal="@dimen/space_1x"
            app:color_checked="@color/sys_blue"
            app:color_tick="@color/sys_white"
            app:color_unchecked="@color/sys_white"
            app:color_unchecked_stroke="@color/sys_gray1"/>
        <ImageView
            android:id="@+id/ivUncheck_item"
            android:visibility="visible"
            android:layout_width="@dimen/icon_s_20"
            android:layout_height="@dimen/icon_s_20"
            android:layout_marginLeft="@dimen/space_1x"
            android:layout_marginRight="@dimen/space_1x"
            android:src="@mipmap/ico_uncheck_60"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="@dimen/space_1x"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivType_item"
        android:padding="@dimen/space_1x"
        android:layout_width="@dimen/space_8x"
        android:layout_height="@dimen/space_8x"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="@dimen/space_0"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_1x"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:ellipsize="middle"
            android:id="@+id/tvName_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tvSize_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tvName_item"/>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_orange"
            android:id="@+id/tvSpeed_item"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/tvSize_item"
            android:layout_marginStart="@dimen/margin1x"
            android:layout_toEndOf="@+id/tvSize_item"/>
    </RelativeLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/clone_lab_toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/margin1x"
            android:paddingBottom="@dimen/margin2x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvCloneLabIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/clone_lab_intro"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"/>
            <include
                android:id="@+id/ilExtremeCompressMode_setting"
                layout="@layout/layout_menu_discover_switch"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvExtremeCompressDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin1x"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/clone_lab_extreme_compress_desc"
                android:paddingStart="@dimen/margin2x"
                android:paddingEnd="@dimen/margin2x"/>
            <include
                android:id="@+id/ilGenericBackupScheme_setting"
                layout="@layout/layout_menu_discover_switch"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvGenericBackupDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin1x"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/clone_lab_generic_backup_desc"
                android:paddingStart="@dimen/margin2x"
                android:paddingEnd="@dimen/margin2x"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_red"
                android:id="@+id/tvCompressWarning"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/clone_lab_compress_warning"
                android:paddingStart="@dimen/margin2x"
                android:paddingEnd="@dimen/margin2x"/>
            <include
                android:id="@+id/ilIntentRoute_setting"
                layout="@layout/layout_menu_discover_switch"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvIntentRouteDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin1x"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/setting_intent_route_enable_desc"
                android:paddingStart="@dimen/margin2x"
                android:paddingEnd="@dimen/margin2x"/>
            <include
                android:id="@+id/ilLoginBackupReminder_setting"
                layout="@layout/layout_menu_discover_switch"/>
            <include
                android:id="@+id/ilBackupRegexTest_setting"
                layout="@layout/layout_menu_discover_switch"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutCloneLabStorageCard"
                android:background="@drawable/bg_white_radius20"
                android:padding="@dimen/margin2x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:layout_marginStart="@dimen/margin1x"
                android:layout_marginEnd="@dimen/margin1x">
                <TextView
                    android:textSize="@dimen/text_body_m"
                    android:textStyle="bold"
                    android:textColor="@color/sys_black"
                    android:id="@+id/tvCloneLabStorageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clone_lab_storage_title"/>
                <TextView
                    android:textSize="@dimen/text_body_s"
                    android:textColor="@color/sys_gray1"
                    android:id="@+id/tvCloneLabStorageSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_0x7f07024c_margin0_5x"
                    android:text="@string/clone_lab_storage_subtitle"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin2x">
                    <TextView
                        android:textSize="@dimen/text_body_s"
                        android:textColor="@color/sys_black"
                        android:id="@+id/tvCloneLabStorageUsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/text_body_s"
                        android:textColor="@color/sys_gray1"
                        android:id="@+id/tvCloneLabStorageFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin2x"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layoutCloneLabStorageBar"
                    android:background="@drawable/bg_clone_lab_storage_track"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/icon_s_20"
                    android:layout_marginTop="@dimen/margin2x"
                    android:clipToOutline="true">
                    <View
                        android:id="@+id/viewCloneLabStorageClone"
                        android:background="@color/sys_blue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <View
                        android:id="@+id/viewCloneLabStorageHost"
                        android:background="@color/sys_purple"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <View
                        android:id="@+id/viewCloneLabStorageOther"
                        android:background="@color/sys_orange"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <View
                        android:id="@+id/viewCloneLabStorageFree"
                        android:background="@color/sys_gray3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin2x">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textStyle="bold"
                            android:textColor="@color/sys_blue"
                            android:id="@+id/tvCloneLabStorageCloneLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/clone_lab_storage_clone_data"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textColor="@color/sys_black"
                            android:id="@+id/tvCloneLabStorageCloneValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin1x">
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textStyle="bold"
                            android:textColor="@color/sys_purple"
                            android:id="@+id/tvCloneLabStorageHostLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/clone_lab_storage_host_data"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textColor="@color/sys_black"
                            android:id="@+id/tvCloneLabStorageHostValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin1x">
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textStyle="bold"
                            android:textColor="@color/sys_orange"
                            android:id="@+id/tvCloneLabStorageOtherLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/clone_lab_storage_other_data"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textColor="@color/sys_black"
                            android:id="@+id/tvCloneLabStorageOtherValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin1x">
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textStyle="bold"
                            android:textColor="@color/sys_gray1"
                            android:id="@+id/tvCloneLabStorageFreeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/clone_lab_storage_free_data"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/text_body_s"
                            android:textColor="@color/sys_black"
                            android:id="@+id/tvCloneLabStorageFreeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_body_s"
                    android:textStyle="bold"
                    android:textColor="@color/sys_black"
                    android:id="@+id/tvCloneLabCacheActionsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin2x"
                    android:text="@string/clone_lab_cache_actions_title"/>
                <include
                    android:id="@+id/ilClearHostCacheAction"
                    layout="@layout/layout_menu_discover_info"/>
                <include
                    android:id="@+id/ilClearCloneCacheAction"
                    layout="@layout/layout_menu_discover_info"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/text_note_m"
                android:textColor="@color/sys_gray1"
                android:gravity="center"
                android:id="@+id/tvCloneLabDesignedBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/clone_lab_designed_by"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/ilTop_setting"
        layout="@layout/layout_essential_toolbar"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_below="@+id/ilTop_setting">
        <include
            android:id="@+id/ilLoginBackupReminder_setting"
            layout="@layout/layout_menu_discover_switch"/>
        <include
            android:id="@+id/ilAutoCloudBackup_setting"
            layout="@layout/layout_menu_discover_switch"/>
        <include
            android:id="@+id/ilBackup_setting"
            layout="@layout/layout_menu_discover_info"/>
        <include
            android:id="@+id/ilRecover_setting"
            layout="@layout/layout_menu_discover_info"/>
        <include
            android:id="@+id/ilClear_setting"
            layout="@layout/layout_menu_discover_info"/>
        <include
            android:id="@+id/ilForceAllBackup_setting"
            layout="@layout/layout_menu_discover_info"/>
        <include
            android:id="@+id/ilCloudBackup_setting"
            layout="@layout/layout_menu_discover_info"/>
        <include
            android:id="@+id/ilCloudRestore_setting"
            layout="@layout/layout_menu_discover_info"/>
        <include
            android:id="@+id/ilScanRestoreClone_setting"
            layout="@layout/layout_menu_discover_info"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>

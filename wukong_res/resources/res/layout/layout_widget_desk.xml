<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_widget_desk_widget_desk_ll"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/avatar_xxl_80"
    android:paddingStart="@dimen/space_0"
    android:paddingEnd="@dimen/space_0_5x">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/layout_widget_desk_app_icon_iv"
        android:layout_width="@dimen/layout_height_l"
        android:layout_height="@dimen/layout_height_l"
        android:src="@drawable/wk_icon"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_white"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/layout_widget_desk_app_name_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_0_5x"
        android:text="@string/xm_name"
        android:singleLine="true"/>
</LinearLayout>

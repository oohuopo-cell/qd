<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/sys_gray6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/sys_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rl_fragment_more_login"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_height_xxl">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_fragment_more_user_head"
                    android:layout_width="@dimen/avatar_l_48"
                    android:layout_height="@dimen/avatar_l_48"
                    android:src="@mipmap/ico_more_head_144"
                    android:layout_marginStart="@dimen/margin2x"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@style/SpRoundedStyle.oval"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/rl_fragment_more_account"
                    android:layout_width="@dimen/space_0"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/space_1x"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_fragment_more_vip_enter"
                    app:layout_constraintStart_toEndOf="@+id/iv_fragment_more_user_head"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:id="@+id/tv_username"
                        android:text="@string/unlogin"
                        android:maxLines="1"
                        style="@style/TvStyleTitle"/>
                    <TextView
                        android:textSize="@dimen/text_note_m"
                        android:id="@+id/tv_fragment_more_account_id"
                        android:layout_below="@+id/tv_username"
                        style="@style/TvStyleTitleContent"/>
                    <ImageView
                        android:id="@+id/vip_icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignTop="@+id/tv_username"
                        android:layout_alignBottom="@+id/tv_username"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="@dimen/res_0x7f07024c_margin0_5x"
                        android:layout_toEndOf="@+id/tv_username"/>
                    <TextView
                        android:textSize="@dimen/text_note_m"
                        android:textColor="@color/sys_gray1"
                        android:id="@+id/tv_fragment_more_account_vip_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_fragment_more_account_id"
                        style="@style/TvStyleTitleContent"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_fragment_more_login"
                    android:text="@string/login_text"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/space_6x"
                    android:paddingEnd="@dimen/space_6x"
                    android:layout_marginEnd="@dimen/margin2x"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/RadiusButton.large"/>
                <info.red.virtual.cusview.RemoveAdEnterButton
                    android:id="@+id/tv_fragment_more_vip_enter"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_purchase"
                    android:layout_marginEnd="@dimen/icon_s_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_fragment_more_menus"
                android:background="@color/sys_gray6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sys_black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_vip_info_top"
        android:background="@mipmap/img_vip_info_top_1080"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <include layout="@layout/layout_essential_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_vip_info_user_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/layout_essential_toolbar_app_bar">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_vip_info_user_head"
            android:layout_width="@dimen/layout_height_l"
            android:layout_height="@dimen/layout_height_l"
            android:layout_marginTop="@dimen/margin2x"
            android:layout_marginBottom="@dimen/margin2x"
            android:src="@mipmap/ico_more_head_144"
            android:layout_marginStart="@dimen/icon_s_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/SpRoundedStyle.oval"/>
        <TextView
            android:textSize="@dimen/text_title_l"
            android:textStyle="bold"
            android:textColor="@color/sys_white"
            android:id="@+id/tv_vip_info_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5x"
            android:text="@string/unlogin"
            android:layout_marginStart="@dimen/space_1x"
            app:layout_constraintStart_toEndOf="@+id/iv_vip_info_user_head"
            app:layout_constraintTop_toTopOf="@+id/iv_vip_info_user_head"/>
        <ImageView
            android:id="@+id/vip_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/res_0x7f07024c_margin0_5x"
            app:layout_constraintBottom_toBottomOf="@+id/tv_vip_info_user_name"
            app:layout_constraintStart_toEndOf="@+id/tv_vip_info_user_name"
            app:layout_constraintTop_toTopOf="@+id/tv_vip_info_user_name"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_vip_info_user_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/tv_vip_info_user_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_info_user_name"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_disable_auto_renewal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1x"
            app:layout_constraintBottom_toBottomOf="@+id/vip_icon"
            app:layout_constraintStart_toEndOf="@+id/vip_icon"
            app:layout_constraintTop_toTopOf="@+id/vip_icon">
            <TextView
                android:textColor="@color/sys_gray1"
                android:id="@+id/tv_disable_auto_renewal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disable_auto_renewal"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <info.red.virtual.cusview.NestedHorizontalScrollview
        android:id="@+id/scroll_vip_info"
        android:background="@drawable/bg_radius24_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        app:layout_constraintBottom_toTopOf="@+id/ll_vip_info_remove_ad_note"
        app:layout_constraintTop_toBottomOf="@+id/cl_vip_info_user_head">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rv_vip_info_remove_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:overScrollMode="never"
                android:paddingStart="@dimen/icon_s_20"
                android:paddingEnd="@dimen/icon_s_20"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/sys_black"
                android:id="@+id/tv_vip_info_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5x"
                android:paddingStart="@dimen/icon_s_20"
                android:paddingEnd="@dimen/icon_s_20"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin1x"
                android:paddingStart="@dimen/icon_s_20"
                android:paddingEnd="@dimen/icon_s_20">
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/activity_vip_ivCheckPrivacy"
                    android:background="@drawable/select_vip_privacy_checkbox"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin1x"/>
                <TextView
                    android:id="@+id/tv_vip_info_mark_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/sys_gray6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_1x"
                android:layout_marginTop="@dimen/space_1x"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/activity_vip_info_coupon_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/activity_vip_info_coupon_view"
                    android:paddingBottom="@dimen/res_0x7f07034e_padding1_5x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/icon_s_20"
                    android:paddingEnd="@dimen/icon_s_20"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/text_body_m"
                        android:textColor="@color/sys_black"
                        android:id="@+id/activity_vip_info_coupon_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1_5x"
                        android:text="@string/vip_coupon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/text_body_s"
                        android:textColor="@color/sys_white"
                        android:id="@+id/activity_vip_info_coupon_timeout"
                        android:background="@drawable/timeout_bg"
                        android:paddingLeft="@dimen/space_1x"
                        android:paddingTop="@dimen/stroke_width_default"
                        android:paddingRight="@dimen/space_1x"
                        android:paddingBottom="@dimen/stroke_width_default"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:layout_marginStart="@dimen/space_1x"
                        android:paddingHorizontal="@dimen/space_1x"
                        android:paddingVertical="@dimen/stroke_width_default"
                        app:layout_constraintLeft_toRightOf="@+id/activity_vip_info_coupon_text"
                        app:layout_constraintTop_toTopOf="@+id/activity_vip_info_coupon_amount"/>
                    <TextView
                        android:textSize="@dimen/text_body_m"
                        android:textColor="@color/sys_red"
                        android:layout_gravity="end"
                        android:id="@+id/activity_vip_info_coupon_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-￥50"
                        app:layout_constraintBottom_toBottomOf="@+id/activity_vip_info_coupon_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/activity_vip_info_coupon_text"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="@color/sys_gray6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_1x"
                    app:layout_constraintTop_toBottomOf="@+id/activity_vip_info_coupon_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vip_info_pay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="@dimen/icon_s_20"
                android:paddingEnd="@dimen/icon_s_20"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <View
                android:background="@color/sys_gray6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_1x"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/icon_s_20"
                android:paddingEnd="@dimen/icon_s_20">
                <TextView
                    android:textColor="@color/sys_black"
                    android:id="@+id/tv_vip_info_function_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/textview_vip_info_title"/>
                <TextView
                    android:textColor="@color/sys_blue"
                    android:id="@+id/tv_vip_info_function_call_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击联系客服"
                    android:layout_marginStart="@dimen/space_1x"
                    style="@style/textview_vip_info_title"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vip_info_remove_ad_function"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="@dimen/icon_s_20"
                android:paddingEnd="@dimen/icon_s_20"/>
        </LinearLayout>
    </info.red.virtual.cusview.NestedHorizontalScrollview>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_vip_info_remove_ad_note"
        android:background="@color/sys_white"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_vip_info_remove_ad_bottom_final_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/sys_red"
            android:id="@+id/tv_money_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableEnd="@drawable/ico_arrow_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_info_remove_ad_bottom_final_money"/>
        <TextView
            android:textColor="@color/sys_white"
            android:gravity="center"
            android:id="@+id/tv_vip_info_order"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vip_enter"
            android:layout_marginStart="@dimen/margin2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_money_detail"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RadiusButton.large"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/vip_info_loading"
        android:visibility="gone"
        android:layout_width="@dimen/icon_display_60"
        android:layout_height="@dimen/icon_display_60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TProgressStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

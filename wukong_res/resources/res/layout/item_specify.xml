<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/sys_white"
    android:paddingLeft="@dimen/icon_s_20"
    android:paddingRight="@dimen/icon_s_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/icon_s_20">
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:id="@+id/tvTitle_item"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server"
        android:paddingVertical="16dp"/>
    <TextView
        android:textSize="@dimen/text_note_m"
        android:textColor="@color/sys_green"
        android:gravity="center"
        android:id="@+id/tvSpeed_item"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_6x"
        android:layout_marginEnd="@dimen/space_2x"
        android:layout_toStartOf="@+id/ivSelect_item"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:id="@+id/tvList_item"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_6x"
        android:text="@string/detail"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/ivSelect_item"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_6x"
        android:src="@mipmap/ico_check_blue_66"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="25dp"
    android:layout_marginRight="25dp"
    android:minWidth="308dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/corner_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17sp"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/common_txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/perm_dialog_tips"
            android:singleLine="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#4d4d4d"
            android:id="@+id/common_txt_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="15dp"
            android:text="@string/perm_dialog_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/common_ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="15dp">
            <View
                android:background="#ffd1d5db"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/common_ll_btns"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#4d4d4d"
                    android:gravity="center"
                    android:id="@+id/common_btn_left"
                    android:background="@drawable/perm_btn_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/perm_dialog_cancel"
                    android:layout_weight="1"/>
                <View
                    android:background="#ffd1d5db"
                    android:layout_width="1px"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#714df6"
                    android:gravity="center"
                    android:id="@+id/common_btn_right"
                    android:background="@drawable/perm_btn_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/perm_dialog_continue"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

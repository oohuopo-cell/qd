<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_6x">
    <TextView
        android:textSize="@dimen/text_body_s"
        android:textColor="@color/sys_black"
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/wk_history_title"
        android:paddingLeft="@dimen/margin2x"
        android:paddingRight="@dimen/margin2x"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6x"
        android:text="@string/search_history"
        android:paddingHorizontal="@dimen/margin2x"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/wk_history_clear"
        android:padding="@dimen/space_1_5x"
        android:layout_width="@dimen/space_6x"
        android:layout_height="@dimen/space_6x"
        android:foreground="@drawable/select_tr25"
        android:src="@mipmap/ico_dustbin"
        android:contentDescription="@string/clear"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/sys_gray6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/team_space_toolbar"
        layout="@layout/layout_essential_toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/margin1x"
            android:paddingBottom="@dimen/margin2x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvTeamModeIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/team_mode_intro"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"/>
            <include
                android:id="@+id/ilTeamModeSwitchSetting"
                layout="@layout/layout_menu_discover_switch"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvTeamModeSwitchDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin1x"
                android:layout_marginBottom="@dimen/margin1x"
                android:text="@string/team_mode_switch_desc"
                android:paddingStart="@dimen/margin2x"
                android:paddingEnd="@dimen/margin2x"/>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textStyle="bold"
                android:textColor="@color/sys_black"
                android:id="@+id/tvTeamInfoSectionTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/team_mode_group_team_info"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llTeamInfoGroup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/ilTeamCurrentAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
                <include
                    android:id="@+id/ilTeamCreateAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textStyle="bold"
                android:textColor="@color/sys_black"
                android:id="@+id/tvTeamActionSectionTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/team_mode_group_team_action"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llTeamActionGroup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/ilTeamAddMemberAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
                <include
                    android:id="@+id/ilTeamSyncStatusAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
                <include
                    android:id="@+id/ilTeamQuitAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textStyle="bold"
                android:textColor="@color/sys_black"
                android:id="@+id/tvTeamMemberSectionTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/team_mode_member_list_title"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llTeamMemberList"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_body_s"
                android:textColor="@color/sys_gray1"
                android:id="@+id/tvTeamMemberEmpty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin1x"
                android:text="@string/team_mode_member_list_empty"
                android:paddingStart="@dimen/margin2x"
                android:paddingEnd="@dimen/margin2x"/>
            <TextView
                android:textSize="@dimen/text_body_m"
                android:textStyle="bold"
                android:textColor="@color/sys_black"
                android:id="@+id/tvTeamGovernanceSectionTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin2x"
                android:text="@string/team_mode_group_high_risk"
                android:paddingStart="@dimen/margin1x"
                android:paddingEnd="@dimen/margin1x"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llTeamGovernanceGroup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/ilTeamAliasMergeAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
                <include
                    android:id="@+id/ilTeamForceUploadAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
                <include
                    android:id="@+id/ilTeamExportCloneStatusAction"
                    layout="@layout/layout_menu_discover_info_grouped"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

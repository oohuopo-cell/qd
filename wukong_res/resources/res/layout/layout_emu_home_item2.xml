<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_white_radius20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin1x">
        <View
            android:id="@+id/img_margin_start"
            android:layout_width="@dimen/margin2x"
            android:layout_height="@dimen/space_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/img_margin_end"
            android:layout_width="@dimen/margin2x"
            android:layout_height="@dimen/space_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_black"
            android:id="@+id/title"
            android:layout_marginTop="@dimen/margin1x"
            app:layout_constraintEnd_toStartOf="@+id/img_margin_end"
            app:layout_constraintStart_toEndOf="@+id/img_margin_start"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/home_layout_item_style"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_gray1"
            android:id="@+id/content"
            android:paddingBottom="@dimen/margin1x"
            android:layout_marginTop="@dimen/margin1x"
            app:layout_constraintBottom_toTopOf="@+id/img"
            app:layout_constraintEnd_toStartOf="@+id/img_margin_end"
            app:layout_constraintStart_toEndOf="@+id/img_margin_start"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/home_layout_item_style"/>
        <ImageView
            android:id="@+id/img"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin1x"
            android:foreground="@drawable/select_tr25"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@+id/bt"
            app:layout_constraintEnd_toStartOf="@+id/img_margin_end"
            app:layout_constraintStart_toEndOf="@+id/img_margin_start"
            app:layout_constraintTop_toBottomOf="@+id/content"
            app:layout_goneMarginBottom="@dimen/space_0"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.1"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/scroll_list"
            android:background="@drawable/round_4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_vertical"
            app:layout_constraintTop_toTopOf="@+id/guideline_horizontal">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/scroll_list_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:layout_marginVertical="2dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/text_parent"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:ellipsize="start"
                    android:gravity="center_vertical"
                    android:id="@+id/scroll_tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/transparent_black_10"
                    android:ellipsize="start"
                    android:gravity="center_vertical"
                    android:id="@+id/scroll_tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"/>
            </FrameLayout>
        </LinearLayout>
        <info.red.virtual.standardui.widget.BtnIconTextView
            android:id="@+id/bt"
            android:visibility="gone"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_margin_end"
            app:layout_constraintStart_toEndOf="@+id/img_margin_start"
            app:layout_constraintTop_toBottomOf="@+id/img"
            style="@style/RadiusButton.large"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/sys_gray6"
    app:cardCornerRadius="@dimen/space_1_5x"
    app:strokeColor="@color/sys_gray4">
    <TextView
        android:textSize="@dimen/text_note_m"
        android:textColor="@color/sys_gray1"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/space_1x"
        android:paddingBottom="@dimen/space_1x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lines="1"
        android:paddingStart="@dimen/space_1_5x"
        android:paddingEnd="@dimen/space_1_5x"
        android:paddingVertical="@dimen/space_1x"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/bt_delete"
        android:visibility="invisible"
        android:layout_width="@dimen/space_1_5x"
        android:layout_height="@dimen/space_1_5x"
        android:src="@drawable/ico_jiguang_close"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/space_0_5x"
        app:tint="@color/sys_gray1"/>
</com.google.android.material.card.MaterialCardView>

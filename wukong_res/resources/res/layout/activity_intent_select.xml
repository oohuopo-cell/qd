<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_radius24_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sys_black"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="选择应用"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_debug_info"
        android:background="@color/intent_debug_bg"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/intent_debug_text"
                android:id="@+id/tv_debug_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="调试信息"
                android:lineSpacingExtra="2dp"
                android:fontFamily="monospace"/>
        </ScrollView>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rv_select_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_add_clone"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/sys_blue"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/sys_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新增分身"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/sys_black"
        android:id="@+id/ll_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:text="取消"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:backgroundTint="@color/sys_gray6"
        style="@style/AppDetailBottomButton.Big"/>
</LinearLayout>

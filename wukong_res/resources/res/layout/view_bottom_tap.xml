<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/tab_layout"
    android:background="@color/sys_white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    app:layout_constraintBottom_toBottomOf="parent">
    <RelativeLayout
        android:id="@+id/rl_main_eapp"
        android:layout_width="@dimen/space_0"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_0"
        android:layout_weight="1">
        <RadioButton
            android:textSize="16dp"
            android:id="@+id/rbt_main_eapp"
            android:checked="true"
            android:text="@string/tab_miniapp"
            style="@style/BottomTabBarRadioButton"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_main_server"
        android:layout_width="@dimen/space_0"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_0"
        android:layout_weight="1">
        <RadioButton
            android:textSize="16dp"
            android:id="@+id/rbt_main_server"
            android:text="@string/tab_service"
            style="@style/BottomTabBarRadioButton"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_white"
            android:id="@+id/iv_point_server"
            android:background="@drawable/shape_tab_red_tip_tes"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/rbt_main_server"
            android:paddingStart="@dimen/padding1x"
            android:paddingEnd="@dimen/padding1x"
            android:layout_alignEnd="@+id/rbt_main_server"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_main_cover"
        android:layout_width="@dimen/space_0"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_0"
        android:layout_weight="1">
        <RadioButton
            android:textSize="16dp"
            android:id="@+id/rbt_main_cover"
            android:text="@string/tab_find"
            style="@style/BottomTabBarRadioButton"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_main_more"
        android:layout_width="@dimen/space_0"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_0"
        android:layout_weight="1">
        <RadioButton
            android:textSize="16dp"
            android:id="@+id/rbt_main_mine"
            android:text="@string/tab_my2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BottomTabBarRadioButton"/>
        <TextView
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/sys_white"
            android:id="@+id/iv_point_mine"
            android:background="@drawable/shape_tab_red_tip_tes"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding1x"
            android:paddingEnd="@dimen/padding1x"
            app:layout_constraintBottom_toTopOf="@+id/rbt_main_mine"
            app:layout_constraintEnd_toEndOf="@+id/rbt_main_mine"
            app:layout_constraintTop_toTopOf="@+id/rbt_main_mine"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/large_text_size"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2x"
        android:text="@string/login_set_password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_old_password_bg"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/sys_gray6"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16sp"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/edit_old_password"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/setting_input_old_pwd"
        android:maxLength="20"
        android:inputType="textPassword"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_old_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_clear"
        app:layout_constraintStart_toStartOf="@+id/view_old_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_old_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_old_clear"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ico_close_72"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_old_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_password_lock"
        app:layout_constraintTop_toTopOf="@+id/view_old_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_old_password_lock"
        android:padding="@dimen/space_0_5x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_password_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_old_password_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_old_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_old_password_bg"/>
    <TextView
        android:textColor="@color/sys_red"
        android:id="@+id/tv_tip_old_password_err"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        app:layout_constraintTop_toBottomOf="@+id/view_old_password_bg"/>
    <View
        android:id="@+id/view_password_bg"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/sys_gray6"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_old_password_err"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16sp"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/edit_password"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/login_set_password_input_hint"
        android:maxLength="20"
        android:inputType="textPassword"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_clear"
        app:layout_constraintStart_toStartOf="@+id/view_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ico_close_72"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_password_lock"
        app:layout_constraintTop_toTopOf="@+id/view_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_password_lock"
        android:padding="@dimen/space_0_5x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_password_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_password_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_password_bg"/>
    <TextView
        android:textColor="@color/sys_red"
        android:id="@+id/tv_tip_password_err"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/login_set_password_error"
        app:layout_constraintTop_toBottomOf="@+id/view_password_bg"/>
    <View
        android:id="@+id/view_confirm_password_bg"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/sys_gray6"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_password_err"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16sp"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/edit_confirm_password"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/login_set_password_input_confirm_hint"
        android:maxLength="20"
        android:inputType="textPassword"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_confirm_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_confirm_clear"
        app:layout_constraintStart_toStartOf="@+id/view_confirm_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_confirm_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_confirm_clear"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ico_close_72"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_confirm_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_confirm_password_lock"
        app:layout_constraintTop_toTopOf="@+id/view_confirm_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_confirm_password_lock"
        android:padding="@dimen/space_0_5x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_password_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_confirm_password_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_confirm_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_confirm_password_bg"/>
    <TextView
        android:textColor="@color/sys_red"
        android:id="@+id/tv_tip_confirm_password_err"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/login_set_password_confirm_error"
        app:layout_constraintTop_toBottomOf="@+id/view_confirm_password_bg"/>
    <TextView
        android:textColor="@color/sys_gray1"
        android:id="@+id/tv_password_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/login_set_password_tip"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_confirm_password_err"/>
    <TextView
        android:enabled="false"
        android:id="@+id/btn_login"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/login_phone_sms_phone_get_code"
        app:layout_constraintTop_toBottomOf="@+id/tv_password_tip"
        style="@style/LoginPrimaryButton"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_skip"
        android:padding="@dimen/space_1x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/icon_s_20"
        android:text="@string/skip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_forget_password"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/login_phone_forget_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_login"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_old_pwd"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="edit_old_password, iv_old_clear, view_old_password_bg, iv_old_password_lock"/>
</androidx.constraintlayout.widget.ConstraintLayout>

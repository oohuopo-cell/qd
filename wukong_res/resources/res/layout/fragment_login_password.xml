<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sys_white"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:importantForAutofill="noExcludeDescendants">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/large_text_size"
        android:textStyle="bold"
        android:textColor="@color/sys_black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2x"
        android:text="@string/login_phone_password_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_edit_bg"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/sys_gray6"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_black"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_qu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_phone_sms_86"
        android:layout_marginStart="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_edit_bg"
        app:layout_constraintStart_toStartOf="@+id/view_edit_bg"
        app:layout_constraintTop_toTopOf="@+id/view_edit_bg"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/sys_gray2"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:layout_marginStart="4dp"
        android:layout_marginVertical="13dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_edit_bg"
        app:layout_constraintStart_toEndOf="@+id/tv_qu"
        app:layout_constraintTop_toTopOf="@+id/view_edit_bg"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16sp"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/edit_phone"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/login_phone_sms_phone_tint"
        android:maxLength="11"
        android:inputType="number"
        android:layout_marginStart="8dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/view_edit_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_edit_bg"
        app:layout_constraintStart_toEndOf="@+id/view_line"
        app:layout_constraintTop_toTopOf="@+id/view_edit_bg"/>
    <TextView
        android:textColor="@color/sys_red"
        android:id="@+id/tv_tip_phone_err"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin1x"
        android:text="@string/login_phone_length_error"
        app:layout_constraintTop_toBottomOf="@+id/view_edit_bg"/>
    <View
        android:id="@+id/view_password_bg"
        android:background="@drawable/bg_white_radius24"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/sys_gray6"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_phone_err"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16sp"
        android:textColor="@color/sys_black"
        android:textColorHint="@color/sys_gray1"
        android:gravity="center_vertical"
        android:id="@+id/edit_password"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/login_phone_password_hint"
        android:maxLength="20"
        android:inputType="textPassword"
        android:layout_marginStart="@dimen/margin2x"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/view_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_clear"
        app:layout_constraintStart_toStartOf="@+id/view_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ico_close_72"
        android:layout_marginEnd="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="@+id/view_password_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_password_lock"
        app:layout_constraintTop_toTopOf="@+id/view_password_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_password_lock"
        android:padding="@dimen/space_0_5x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_password_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_password_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_password_bg"
        app:layout_constraintTop_toTopOf="@+id/view_password_bg"/>
    <TextView
        android:textColor="@color/sys_red"
        android:id="@+id/tv_tip_password_err"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/login_phone_password_error"
        app:layout_constraintTop_toBottomOf="@+id/view_password_bg"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_remember_pwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_password_err">
        <TextView
            android:id="@+id/check_remember_pwd"
            android:background="@drawable/select_vip_privacy_checkbox"
            android:layout_width="@dimen/icon_s_20"
            android:layout_height="@dimen/icon_s_20"/>
        <TextView
            android:textSize="@dimen/text_body_m"
            android:textColor="@color/sys_gray1"
            android:id="@+id/tv_remember_pwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_remember_password"
            android:layout_marginStart="@dimen/space_1x"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:id="@+id/btn_login"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/login_text"
        app:layout_constraintTop_toBottomOf="@+id/ll_remember_pwd"
        style="@style/LoginPrimaryButton"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bt_agree_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_login">
        <TextView
            android:enabled="true"
            android:id="@+id/check_agree_policy"
            android:background="@drawable/select_vip_privacy_checkbox"
            android:layout_width="@dimen/icon_s_20"
            android:layout_height="@dimen/icon_s_20"
            android:checked="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_login_bottom_agree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/tv_login_policy"/>
        <TextView
            android:textSize="@dimen/text_note_m"
            android:textColor="@color/sys_white"
            android:id="@+id/tv_tip_bubble"
            android:background="@drawable/bg_tip_bubble"
            android:paddingLeft="@dimen/margin1x"
            android:paddingRight="@dimen/margin1x"
            android:paddingBottom="@dimen/space_1x"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0"
            android:text="@string/login_phone_sms_tip_bubble"
            android:backgroundTint="@color/sys_black"
            android:paddingHorizontal="@dimen/margin1x"
            app:layout_constraintStart_toStartOf="@+id/check_agree_policy"
            app:layout_constraintTop_toBottomOf="@+id/check_agree_policy"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_sms_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/login_phone_sms_login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_agree_policy"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_body_m"
        android:textColor="@color/sys_blue"
        android:id="@+id/tv_forget_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin2x"
        android:text="@string/login_phone_forget_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_login"/>
    <include
        android:id="@+id/layout_third_party"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_login_third_party"/>
</androidx.constraintlayout.widget.ConstraintLayout>

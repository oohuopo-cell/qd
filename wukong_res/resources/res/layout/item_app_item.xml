<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/icon_display_60">
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:layout_gravity="center_vertical"
        android:id="@+id/app_icon"
        android:layout_width="@dimen/space_5x"
        android:layout_height="@dimen/space_5x"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/margin2x"/>
    <TextView
        android:textSize="@dimen/text_body_m"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin1x"/>
    <TextView
        android:textSize="@dimen/text_body_s"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/bt_add"
        android:paddingTop="@dimen/margin1x"
        android:paddingBottom="@dimen/margin1x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_popup_desktop"
        android:paddingStart="@dimen/space_1_5x"
        android:paddingEnd="@dimen/space_1_5x"
        android:layout_marginStart="@dimen/margin2x"
        android:layout_marginEnd="@dimen/margin2x"
        android:paddingVertical="@dimen/margin1x"
        style="@style/RadiusButton"/>
</LinearLayout>

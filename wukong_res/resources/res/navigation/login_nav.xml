<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_nav"
    app:startDestination="@+id/loginTypeFragment">
    <fragment
        android:label="LoginTypeFragment"
        android:name="info.red.virtual.activity.usercenter.login.LoginTypeFragment"
        android:id="@+id/loginTypeFragment">
        <action
            android:id="@+id/action_to_verifyCode"
            app:destination="@+id/verifyCodeFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <action
            android:id="@+id/action_to_loginPassword"
            app:destination="@+id/loginPasswordFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="VerifyCodeFragment"
        android:name="info.red.virtual.activity.usercenter.login.VerifyCodeFragment"
        android:id="@+id/verifyCodeFragment">
        <argument
            android:name="phone"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwd"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwdType"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/action_to_setPassword"
            app:destination="@+id/setPasswordFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="LoginPasswordFragment"
        android:name="info.red.virtual.activity.usercenter.login.LoginPasswordFragment"
        android:id="@+id/loginPasswordFragment">
        <argument
            android:name="phone"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/action_to_verifyCode"
            app:destination="@+id/verifyCodeFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <action
            android:id="@+id/action_to_setPassword"
            app:destination="@+id/setPasswordFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <action
            android:id="@+id/action_to_loginType"
            app:destination="@+id/loginTypeFragment"
            app:enterAnim="@anim/fragment_close_enter"
            app:exitAnim="@anim/fragment_close_exit"
            app:popEnterAnim="@anim/fragment_open_enter"
            app:popExitAnim="@anim/fragment_open_exit"
            app:popUpTo="@+id/loginTypeFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="SetPasswordFragment"
        android:name="info.red.virtual.activity.usercenter.login.SetPasswordFragment"
        android:id="@+id/setPasswordFragment">
        <action
            android:id="@+id/action_to_verifyCode"
            app:destination="@+id/verifyCodeFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <argument
            android:name="phone"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwdType"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
</navigation>

<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setting_nav"
    app:startDestination="@+id/settingFragment">
    <fragment
        android:label="SettingFragment"
        android:name="info.red.virtual.activity.setting.SettingFragment"
        android:id="@+id/settingFragment">
        <action
            android:id="@+id/action_to_settingAccount"
            app:destination="@+id/settingAccountFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <action
            android:id="@+id/action_to_settingIntentRouteSupport"
            app:destination="@+id/settingIntentRouteSupportFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="SettingIntentRouteSupportFragment"
        android:name="info.red.virtual.activity.setting.SettingIntentRouteSupportFragment"
        android:id="@+id/settingIntentRouteSupportFragment"/>
    <fragment
        android:label="SettingAccountFragment"
        android:name="info.red.virtual.activity.setting.SettingAccountFragment"
        android:id="@+id/settingAccountFragment">
        <action
            android:id="@+id/action_to_setPassword"
            app:destination="@+id/setPasswordFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <action
            android:id="@+id/action_to_modifyPwd"
            app:destination="@+id/modifyPwdFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <action
            android:id="@+id/action_to_bindPhone"
            app:destination="@+id/bindPhoneFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="BindPhoneFragment"
        android:name="info.red.virtual.activity.setting.BindPhoneFragment"
        android:id="@+id/bindPhoneFragment">
        <action
            android:id="@+id/action_to_verifyCode"
            app:destination="@+id/verifyCodeFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="SetPasswordFragment"
        android:name="info.red.virtual.activity.usercenter.login.SetPasswordFragment"
        android:id="@+id/setPasswordFragment">
        <action
            android:id="@+id/action_to_verifyCode"
            app:destination="@+id/verifyCodeFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
        <argument
            android:name="phone"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwdType"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="ModifyPwdFragment"
        android:name="info.red.virtual.activity.usercenter.login.ModifyPwdFragment"
        android:id="@+id/modifyPwdFragment">
        <argument
            android:name="phone"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwdType"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/action_to_setPassword"
            app:destination="@+id/setPasswordFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="VerifyCodeFragment"
        android:name="info.red.virtual.activity.usercenter.login.VerifyCodeFragment"
        android:id="@+id/verifyCodeFragment">
        <argument
            android:name="phone"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwd"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="pwdType"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/action_to_setPassword"
            app:destination="@+id/setPasswordFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
</navigation>

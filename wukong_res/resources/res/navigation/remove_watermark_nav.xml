<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/remove_watermark_nav"
    app:startDestination="@+id/removeWatermarkFragment">
    <fragment
        android:label="RemoveWatermarkFragment"
        android:name="info.red.virtual.watermark.RemoveWatermarkFragment"
        android:id="@+id/removeWatermarkFragment">
        <action
            android:id="@+id/action_to_videoPreviewFragment"
            app:destination="@+id/videoPreviewFragment"
            app:enterAnim="@anim/fragment_open_enter"
            app:exitAnim="@anim/fragment_open_exit"
            app:popEnterAnim="@anim/fragment_close_enter"
            app:popExitAnim="@anim/fragment_close_exit"/>
    </fragment>
    <fragment
        android:label="VideoPreviewFragment"
        android:name="info.red.virtual.watermark.VideoPreviewFragment"
        android:id="@+id/videoPreviewFragment">
        <argument
            android:name="url"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
</navigation>
